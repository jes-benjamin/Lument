  }

  .input-box {
    width: 370px;
    height: 48px;
    border-radius: 18px;
    background-color: #1a1a1a;
    margin-top: 4px;
    padding-left: 16px;
    padding-right: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .input-value {
    width: 338px;
    color: #ffffff;
    font-size: 24px;
    font-weight: 800;
  }

  .convert-arrow {
    width: 370px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arrow-text {
    color: #888888;
    font-size: 24px;
  }

  .result-box {
    width: 370px;
    height: 48px;
    border-radius: 18px;
    background-color: #1a1a1a;
    margin-top: 2px;
    padding-left: 16px;
    padding-right: 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .result-label {
    width: 80px;
    color: #888888;
    font-size: 16px;
    font-weight: 800;
  }

  .result-value {
    width: 258px;
    color: #9370db;
    font-size: 22px;
    font-weight: 800;
  }

  .to-base-nav {
    width: 330px;
    height: 38px;
    margin-top: 4px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .small-btn {
    width: 50px;
    height: 34px;
    border-radius: 17px;
