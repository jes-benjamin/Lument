    text-align: center;
  }

  .keyboard {
    width: 360px;
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .key-row {
    width: 360px;
    height: 50px;
    display: flex;
    flex-direction: row;
    justify-content: center;
  }

  .key {
    width: 78px;
    height: 44px;
    border-radius: 22px;
    margin-left: 4px;
    margin-right: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-num {
    background-color: rgba(128, 128, 128, 0.35);
    border-width: 2px;
    border-color: #888888;
  }

  .key-func {
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
  }

  .key-text {
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
  }

  .key-small {
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var BASES = [2, 8, 10, 16]
  var BASE_NAMES = { 2: '二进制', 8: '八进制', 10: '十进制', 16: '十六进制' }
  var HISTORY_KEY = 'calc_history_v2'

  export default {
    private: {
      fromBaseIndex: 2,
      toBaseIndex: 0,
      inputValue: '',
      vibrationOn: true
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    computed: {
      fromBase() {
        return BASES[this.fromBaseIndex]
      },
      fromBaseName() {
        return BASE_NAMES[this.fromBase]
      },
      toBaseName() {
        return BASE_NAMES[BASES[this.toBaseIndex]]
      },
      inputText() {
        return this.inputValue || '0'
      },
      outputValue() {
        if (!this.inputValue) return '0'
        var dec = parseInt(this.inputValue, this.fromBase)
        if (isNaN(dec)) return '错误'
        return dec.toString(BASES[this.toBaseIndex]).toUpperCase()
      }
    },

    onBackPress() {
      this.saveHistory()
      router.back()
      return true
    },

    prevFromBase() {
      this.doVibrate()
      this.fromBaseIndex = this.fromBaseIndex > 0 ? this.fromBaseIndex - 1 : BASES.length - 1
      this.inputValue = ''
    },

    nextFromBase() {
      this.doVibrate()
      this.fromBaseIndex = this.fromBaseIndex < BASES.length - 1 ? this.fromBaseIndex + 1 : 0
      this.inputValue = ''
    },

    prevToBase() {
      this.doVibrate()
      this.toBaseIndex = this.toBaseIndex > 0 ? this.toBaseIndex - 1 : BASES.length - 1
    },

    nextToBase() {
      this.doVibrate()
      this.toBaseIndex = this.toBaseIndex < BASES.length - 1 ? this.toBaseIndex + 1 : 0
    },

    pressKey(key) {
      this.doVibrate()
      var valid = this.getValidChars()
      if (valid.indexOf(key) === -1) return
      if (this.inputValue.length > 12) return
      this.inputValue += key
    },

    getValidChars() {
      var base = this.fromBase
      var chars = '0123456789ABCDEF'
      return chars.substring(0, base)
    },

    deleteInput() {
      this.doVibrate()
      this.inputValue = this.inputValue.substring(0, this.inputValue.length - 1)
    },

    clearInput() {
      this.doVibrate()
      this.inputValue = ''
    },

    saveHistory() {
      if (!this.inputValue) return
      var expr = this.inputValue + '(' + BASE_NAMES[this.fromBase] + ')'
      var result = this.outputValue
      if (result === '错误' || result === '0') return
      result = result + '(' + BASE_NAMES[BASES[this.toBaseIndex]] + ')'
      var self = this
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var list = []
          if (data) {
            try { list = JSON.parse(data) } catch (e) { list = [] }
          }
          list.push({ type: '进制转换', expr: expr, result: result })
          if (list.length > 30) list = list.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(list) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: '进制转换', expr: expr, result: result }]) })
        }
      })
    }
  }
</script>
