<template>
  <div class="page">
    <div class="title-bar">
      <text class="title-text">进制转换</text>
    </div>

    <div class="base-nav">
      <div class="base-btn" onclick="prevFromBase"><text class="base-nav-text">‹</text></div>
      <text class="base-label">{{fromBaseName}}</text>
      <div class="base-btn" onclick="nextFromBase"><text class="base-nav-text">›</text></div>
    </div>

    <div class="input-box">
      <text class="input-value">{{inputText}}</text>
    </div>

    <div class="convert-arrow"><text class="arrow-text">↓</text></div>

    <div class="result-box">
      <text class="result-label">{{toBaseName}}:</text>
      <text class="result-value">{{outputValue}}</text>
    </div>

    <div class="to-base-nav">
      <div class="small-btn" onclick="prevToBase"><text class="small-text">‹</text></div>
      <text class="to-base-label">输出: {{toBaseName}}</text>
      <div class="small-btn" onclick="nextToBase"><text class="small-text">›</text></div>
    </div>

    <div class="keyboard">
      <div class="key-row">
        <div class="key key-num" onclick="pressKey('7')"><text class="key-text">7</text></div>
        <div class="key key-num" onclick="pressKey('8')"><text class="key-text">8</text></div>
        <div class="key key-num" onclick="pressKey('9')"><text class="key-text">9</text></div>
        <div class="key key-func" onclick="deleteInput"><text class="key-small">DEL</text></div>
      </div>
      <div class="key-row">
        <div class="key key-num" onclick="pressKey('4')"><text class="key-text">4</text></div>
        <div class="key key-num" onclick="pressKey('5')"><text class="key-text">5</text></div>
        <div class="key key-num" onclick="pressKey('6')"><text class="key-text">6</text></div>
        <div class="key key-func" onclick="clearInput"><text class="key-text">C</text></div>
      </div>
      <div class="key-row">
        <div class="key key-num" onclick="pressKey('1')"><text class="key-text">1</text></div>
        <div class="key key-num" onclick="pressKey('2')"><text class="key-text">2</text></div>
        <div class="key key-num" onclick="pressKey('3')"><text class="key-text">3</text></div>
        <div class="key key-num" onclick="pressKey('0')"><text class="key-text">0</text></div>
      </div>
      <div class="key-row" if="{{fromBase === 16}}">
        <div class="key key-num" onclick="pressKey('A')"><text class="key-text">A</text></div>
        <div class="key key-num" onclick="pressKey('B')"><text class="key-text">B</text></div>
        <div class="key key-num" onclick="pressKey('C')"><text class="key-text">C</text></div>
        <div class="key key-num" onclick="pressKey('D')"><text class="key-text">D</text></div>
      </div>
      <div class="key-row" if="{{fromBase === 16}}">
        <div class="key key-num" onclick="pressKey('E')"><text class="key-text">E</text></div>
        <div class="key key-num" onclick="pressKey('F')"><text class="key-text">F</text></div>
      </div>
    </div>
  </div>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .title-bar {
    width: 370px;
    height: 36px;
    margin-top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .title-text {
    color: #ffffff;
    font-size: 28px;
    font-weight: 800;
  }

  .base-nav {
    width: 330px;
    height: 42px;
    margin-top: 6px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .base-btn {
    width: 56px;
    height: 38px;
    border-radius: 19px;
    background-color: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .base-nav-text {
    color: #ffffff;
    font-size: 28px;
    font-weight: 800;
  }

  .base-label {
    width: 160px;
    height: 38px;
    color: #9370db;
    font-size: 22px;
