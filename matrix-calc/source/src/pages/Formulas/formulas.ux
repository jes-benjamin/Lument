        { title: '二次函数一般式', content: 'y = ax²+bx+c，对称轴 x=-b/(2a)，顶点纵坐标 (4ac-b²)/(4a)' },
        { title: '二次函数交点式', content: 'y = a(x-x₁)(x-x₂)，x₁、x₂ 为与x轴交点横坐标' },
        { title: '反比例函数', content: 'y = k/x，双曲线，k>0 在一三象限，图像关于原点对称' },
        { title: '奇偶性', content: 'f(-x)=f(x) 偶函数（关于y轴）；f(-x)=-f(x) 奇函数（关于原点）' },
        { title: '奇函数结论', content: '奇函数若在 x=0 处有定义，则 f(0)=0' },
        { title: '图像平移', content: '左加右减（对x），上加下减（对y）' },
        { title: '求值域方法', content: '配方法、判别式法、换元法、单调性法、分离常数法' }
      ]
    },
    {
      name: '指数与对数',
      list: [
        { title: '指数运算法则', content: 'aᵐ·aⁿ=aᵐ⁺ⁿ，(aᵐ)ⁿ=aᵐⁿ，aᵐ÷aⁿ=aᵐ⁻ⁿ，(ab)ᵐ=aᵐbᵐ' },
        { title: '分数与负指数', content: 'a^(m/n) = ⁿ√(aᵐ)，a⁻ⁿ = 1/aⁿ（a>0）' },
        { title: '对数定义', content: 'a^b=N ⟺ logₐN=b（a>0 且 a≠1）' },
        { title: '对数运算法则', content: 'logₐ(MN)=logₐM+logₐN，logₐ(M/N)=logₐM-logₐN，logₐMⁿ=n·logₐM' },
        { title: '换底公式', content: 'logₐb = logc b ÷ logc a' },
        { title: '常用结论', content: 'lg2+lg5=1，lg1=0，logₐa=1，lne=1' },
        { title: '指数函数', content: 'y=aˣ 过 (0,1)，a>1 增，0<a<1 减，值域 (0,+∞)' },
        { title: '对数函数', content: 'y=logₐx 过 (1,0)，a>1 增，0<a<1 减，定义域 (0,+∞)' }
      ]
    },
    {
      name: '三角函数',
      list: [
        { title: '锐角三角函数定义', content: 'sinA=对边/斜边，cosA=邻边/斜边，tanA=对边/邻边' },
        { title: '同角基本关系', content: 'sin²α+cos²α = 1，tanα = sinα/cosα' },
        { title: '诱导公式口诀', content: '奇变偶不变，符号看象限；sin(π/2-α)=cosα 等' },
        { title: '和角公式', content: 'sin(α±β)=sinαcosβ±cosαsinβ；cos(α±β)=cosαcosβ∓sinαsinβ' },
        { title: '和角正切', content: 'tan(α±β) = (tanα±tanβ)/(1∓tanαtanβ)' },
        { title: '二倍角公式', content: 'sin2α=2sinαcosα；cos2α=cos²α-sin²α=2cos²α-1=1-2sin²α' },
        { title: '二倍角正切', content: 'tan2α = 2tanα/(1-tan²α)' },
        { title: '半角公式', content: 'sin(α/2)=±√((1-cosα)/2)，cos(α/2)=±√((1+cosα)/2)' },
        { title: '和差化积', content: 'sinA+sinB=2sin((A+B)/2)cos((A-B)/2)；cosA+cosB=2cos((A+B)/2)cos((A-B)/2)' },
        { title: '积化和差', content: 'sinAcosB=(sin(A+B)+sin(A-B))/2；cosAcosB=(cos(A+B)+cos(A-B))/2' },
        { title: '辅助角公式', content: 'asinx+bcosx = √(a²+b²)·sin(x+φ)' },
        { title: '特殊角三角值', content: 'sin30°=1/2，sin45°=√2/2，sin60°=√3/2；tan30°=√3/3，tan60°=√3' },
        { title: '正弦定理', content: 'a/sinA = b/sinB = c/sinC = 2R（R 外接圆半径）' },
        { title: '余弦定理', content: 'c² = a²+b²-2ab·cosC' },
        { title: '三角形面积', content: 'S = (1/2)ab·sinC' },
        { title: '函数性质', content: 'y=sinx 周期2π、值域[-1,1]；y=tanx 周期π、x≠π/2+kπ' }
      ]
    },
    {
      name: '数列',
      list: [
        { title: '等差数列通项', content: 'aₙ = a₁ + (n-1)d' },
        { title: '等差数列求和', content: 'Sₙ = n(a₁+aₙ)/2 = na₁ + n(n-1)d/2' },
        { title: '等差中项', content: '2b = a+c（a、b、c 成等差数列）' },
        { title: '等差数列性质', content: 'aₘ+aₙ = aₚ+a_q（m+n=p+q）' },
        { title: '等比数列通项', content: 'aₙ = a₁·q^(n-1)' },
        { title: '等比数列求和', content: 'q=1 时 Sₙ=na₁；q≠1 时 Sₙ = a₁(1-qⁿ)/(1-q)' },
        { title: '等比中项', content: 'b² = a·c（a、b、c 成等比数列，a、c 同号）' },
        { title: '通项与前n项和', content: 'aₙ = S₁（n=1）；aₙ = Sₙ-Sₙ₋₁（n≥2）' },
        { title: '常用求和公式', content: '1+2+…+n = n(n+1)/2；1²+2²+…+n² = n(n+1)(2n+1)/6' },
        { title: '裂项求和', content: '1/(n(n+1)) = 1/n - 1/(n+1)' }
      ]
    },
    {
      name: '平面向量',
      list: [
        { title: '加减法则', content: '三角形法则（首尾相接）、平行四边形法则' },
        { title: '数量积', content: 'a·b = |a||b|cosθ = x₁x₂+y₁y₂' },
        { title: '垂直条件', content: 'a⊥b ⟺ a·b = 0 ⟺ x₁x₂+y₁y₂ = 0' },
        { title: '夹角公式', content: 'cosθ = (x₁x₂+y₁y₂)/(√(x₁²+y₁²)·√(x₂²+y₂²))' },
        { title: '模长公式', content: '|a|² = a·a = x²+y²，|a| = √(x²+y²)' },
        { title: '坐标运算', content: 'a+b = (x₁+x₂, y₁+y₂)，λa = (λx, λy)' },
        { title: '投影', content: 'b 在 a 方向的投影 = |b|cosθ' },
        { title: '中点坐标', content: '((x₁+x₂)/2, (y₁+y₂)/2)' },
        { title: '共线条件', content: 'a∥b ⟺ x₁y₂-x₂y₁ = 0' }
      ]
    },
    {
      name: '解析几何',
      list: [
        { title: '斜率公式', content: 'k = (y₂-y₁)/(x₂-x₁) = tanα（α 倾斜角）' },
        { title: '点斜式', content: 'y - y₀ = k(x - x₀)' },
        { title: '斜截式', content: 'y = kx + b' },
        { title: '两点式', content: '(y-y₁)/(y₂-y₁) = (x-x₁)/(x₂-x₁)' },
        { title: '截距式', content: 'x/a + y/b = 1（a、b 为横纵截距）' },
        { title: '一般式', content: 'Ax + By + C = 0（A、B 不同时为 0）' },
        { title: '平行与垂直', content: 'k₁=k₂ 且不重合则平行；k₁·k₂=-1 则垂直' },
        { title: '两点间距离', content: '|AB| = √((x₂-x₁)² + (y₂-y₁)²)' },
        { title: '点到直线距离', content: 'd = |Ax₀+By₀+C|/√(A²+B²)' },
        { title: '圆的方程', content: '(x-a)² + (y-b)² = r²；一般式 x²+y²+Dx+Ey+F=0' },
        { title: '椭圆标准方程', content: 'x²/a² + y²/b² = 1（a>b>0），a² = b²+c²，e = c/a' },
        { title: '椭圆焦半径', content: '|PF₁| = a+ex₀，|PF₂| = a-ex₀（左焦点、右焦点）' },
        { title: '双曲线标准方程', content: 'x²/a² - y²/b² = 1，c² = a²+b²，渐近线 y = ±(b/a)x' },
        { title: '抛物线标准方程', content: 'y² = 2px（p>0），焦点 (p/2, 0)，准线 x = -p/2' },
        { title: '通径（焦点弦最短）', content: '椭圆与双曲线 2b²/a；抛物线 2p' },
        { title: '抛物线焦点弦', content: '过焦点弦长 = x₁+x₂+p' }
      ]
    },
    {
      name: '立体几何',
      list: [
        { title: '柱体体积', content: 'V = Sh（S 底面积，h 高）' },
        { title: '锥体体积', content: 'V = Sh/3' },
        { title: '台体体积', content: 'V = h(S₁+√(S₁S₂)+S₂)/3' },
        { title: '球的体积', content: 'V = 4πr³/3' },
        { title: '球的表面积', content: 'S = 4πr²' },
        { title: '侧面积公式', content: '圆柱侧面积 S=2πrh；圆锥侧面积 S=πrl' },
        { title: '长方体对角线', content: 'd = √(a²+b²+c²)' },
        { title: '等体积法', content: '三棱锥可变换顶点，V = (1/3)Sh，用于求高' },
        { title: '异面直线所成角', content: 'cosθ = |cos⟨m,n⟩|（取方向向量夹角的绝对值）' },
        { title: '二面角', content: 'cosθ = (n₁·n₂)/(|n₁||n₂|)（两法向量夹角）' },
        { title: '线面角', content: 'sinθ = |cos⟨方向向量, 平面法向量⟩|' }
      ]
    },
    {
      name: '概率与统计',
      list: [
        { title: '古典概型', content: 'P(A) = A 包含的基本事件数 ÷ 基本事件总数' },
        { title: '对立事件', content: 'P(A) = 1 - P(非A)' },
        { title: '独立事件', content: 'P(AB) = P(A)·P(B)' },
        { title: '条件概率', content: 'P(A|B) = P(AB)/P(B)' },
        { title: '互斥事件', content: 'P(A∪B) = P(A) + P(B)' },
        { title: '数学期望', content: 'E(X) = Σ xᵢpᵢ' },
        { title: '方差', content: 'D(X) = Σ(xᵢ-E(X))²pᵢ = E(X²) - (E(X))²' },
        { title: '期望方差性质', content: 'E(aX+b) = aE(X)+b；D(aX+b) = a²D(X)' },
        { title: '二项分布', content: 'X~B(n,p)，E(X)=np，D(X)=np(1-p)' },
        { title: '回归直线', content: 'ŷ = bx+a，b = Σ(xᵢ-x̄)(yᵢ-ȳ)/Σ(xᵢ-x̄)²，必过 (x̄, ȳ)' },
        { title: '平均数中位数众数', content: '平均数=总和÷个数；中位数排序居中；众数出现次数最多' },
        { title: '方差意义', content: '方差越小，数据波动越小越稳定' }
      ]
    },
    {
      name: '排列组合与二项式',
      list: [
        { title: '排列数公式', content: 'A(n,m) = n!/(n-m)! = n(n-1)…(n-m+1)' },
        { title: '组合数公式', content: 'C(n,m) = n!/(m!(n-m)!)' },
        { title: '组合数性质', content: 'C(n,m) = C(n,n-m)；C(n,m) = C(n-1,m-1) + C(n-1,m)' },
        { title: '全排列', content: 'P(n) = n!（n 个元素全部排列）' },
        { title: '二项式定理', content: '(a+b)ⁿ = Σ C(n,k)·a^(n-k)·b^k（k 从 0 到 n）' },
        { title: '通项公式', content: 'T(r+1) = C(n,r)·a^(n-r)·b^r' },
        { title: '二项式系数和', content: 'C(n,0)+C(n,1)+…+C(n,n) = 2ⁿ' },
        { title: '系数最值', content: 'n 为偶数时中间一项系数最大；n 为奇数时中间两项相等且最大' },
        { title: '分组分配', content: '先分组后分配；平均分组要除以组数的阶乘' },
        { title: '特殊元素优先', content: '相邻用捆绑法，不相邻用插空法，至少至多用间接法' }
      ]
    },
    {
      name: '导数与积分',
      list: [
        { title: '基本导数', content: "C'=0，(xⁿ)' = nxⁿ⁻¹，(√x)' = 1/(2√x)" },
        { title: '三角函数导数', content: "(sinx)' = cosx，(cosx)' = -sinx" },
        { title: '指数对数导数', content: "(eˣ)' = eˣ，(aˣ)' = aˣlna，(lnx)' = 1/x" },
        { title: '四则运算法则', content: "(u±v)' = u'±v'，(uv)' = u'v+uv'，(u/v)' = (u'v-uv')/v²" },
        { title: '复合函数求导', content: "(f(g(x)))' = f'(g(x))·g'(x)（链式法则，从外到内）" },
        { title: '可导与连续', content: '可导必连续，连续不一定可导' },
        { title: '极值点条件', content: "f'(x₀)=0 且在 x₀ 两侧导数变号" },
        { title: '平均变化率', content: 'Δy/Δx = (f(x₂)-f(x₁))/(x₂-x₁)' },
