        { title: '定积分几何意义', content: '曲线与x轴、直线x=a、x=b 围成的面积（x轴上方为正）' }
      ]
    },
    {
      name: '复数',
      list: [
        { title: '虚数单位', content: 'i² = -1，i⁴ = 1，i 的幂以 4 为周期' },
        { title: '代数形式', content: 'z = a + bi（a 为实部，b 为虚部）' },
        { title: '加减法', content: '(a+bi)+(c+di) = (a+c)+(b+d)i' },
        { title: '乘法', content: '(a+bi)(c+di) = (ac-bd)+(ad+bc)i' },
        { title: '除法', content: '(a+bi)/(c+di) = ((a+bi)(c-di))/(c²+d²)' },
        { title: '共轭复数', content: 'z=a+bi 的共轭为 a-bi，z×共轭 = a²+b² = |z|²' },
        { title: '模', content: '|z| = √(a²+b²)' },
        { title: '实部与虚部', content: '实部 = (z+共轭)/2，虚部 = (z-共轭)/(2i)' },
        { title: '三角形式', content: 'z = r(cosθ+isinθ)，棣莫弗：zⁿ = rⁿ(cosnθ+isinnθ)' }
      ]
    },
    {
      name: '平面几何（初中）',
      list: [
        { title: '勾股定理', content: '直角三角形 a²+b² = c²（c 为斜边）；反之成立' },
        { title: '三角形内角和', content: '任意三角形内角和 = 180°' },
        { title: '多边形内角和', content: '(n-2)×180°；正n边形每角 = (n-2)×180°/n' },
        { title: '三角形面积', content: 'S = (1/2)×底×高' },
        { title: '平行四边形面积', content: 'S = 底×高' },
        { title: '梯形面积', content: 'S = (上底+下底)×高÷2' },
        { title: '菱形面积', content: 'S = 对角线₁×对角线₂÷2' },
        { title: '扇形面积与弧长', content: 'S = nπr²/360 = (1/2)lr；l = nπr/180' },
        { title: '全等判定', content: 'SSS、SAS、ASA、AAS、HL（直角三角形）' },
        { title: '相似性质', content: '对应边成比例；面积比 = 相似比²，体积比 = 相似比³' },
        { title: '圆周角定理', content: '同弧所对圆心角 = 2×圆周角；直径所对圆周角 = 90°' },
        { title: '切线性质', content: '切线垂直于过切点的半径；从圆外一点引两条切线长相等' },
        { title: '垂径定理', content: '垂直于弦的直径平分弦，并且平分弦所对的两条弧' },
        { title: '点与圆位置', content: '圆心距 d>r 相离，d=r 相切，d<r 相交' }
      ]
    },
    {
      name: '数与式（初中）',
      list: [
        { title: '乘方符号规则', content: '正数任何次幂为正；负数奇次幂为负，偶次幂为正' },
        { title: '科学记数法', content: 'a×10ⁿ，其中 1≤|a|<10' },
        { title: '绝对值', content: '|a| = a（a≥0）；|a| = -a（a<0）' },
        { title: '比例性质', content: 'a/b = c/d ⟹ ad = bc；a/b = c/b ⟹ a=c' },
        { title: '平方根', content: '(√a)² = a（a≥0）；√(a²) = |a|' },
        { title: '实数分类', content: '实数分有理数（整数、分数）和无理数（无限不循环小数）' },
        { title: '加权平均数', content: '各组数据×权重之和 ÷ 权重之和' },
        { title: '方差（初中）', content: 's² = [(x₁-x̄)²+(x₂-x̄)²+…+(xₙ-x̄)²]/n' },
        { title: '一元一次方程', content: 'ax+b=0（a≠0）的解为 x = -b/a' },
        { title: '不等式基本性质', content: 'a>b ⟹ a+c>b+c；a>b 且 c>0 ⟹ ac>bc；c<0 时反向' }
      ]
    },
    {
      name: '物理公式（初高中）',
      list: [
        { title: '速度', content: 'v = s/t（单位 m/s）' },
        { title: '加速度', content: 'a = (v - v₀)/t（m/s²）' },
        { title: '匀变速直线运动', content: 'v = v₀+at；s = v₀t+at²/2；v²-v₀² = 2as' },
        { title: '牛顿第二定律', content: 'F = ma（N）' },
        { title: '重力', content: 'G = mg（g ≈ 9.8 N/kg）' },
        { title: '密度', content: 'ρ = m/V（kg/m³）' },
        { title: '压强', content: 'p = F/S（Pa）；液体内部 p = ρgh' },
        { title: '阿基米德原理', content: 'F浮 = ρ液·g·V排' },
        { title: '功与功率', content: 'W = Fs（J）；P = W/t = Fv（W）' },
        { title: '机械能', content: '动能 Ek = mv²/2；重力势能 Ep = mgh；守恒时总和不变' },
        { title: '杠杆平衡', content: 'F₁·l₁ = F₂·l₂' },
        { title: '热量计算', content: 'Q = cmΔt（c 比热容）；燃料燃烧 Q = mq' },
        { title: '欧姆定律', content: 'I = U/R（A、V、Ω）' },
        { title: '电功与电功率', content: 'W = UIt；P = UI = I²R = U²/R' },
        { title: '焦耳定律', content: 'Q = I²Rt' },
        { title: '串联电路', content: 'R = R₁+R₂，U = U₁+U₂，电流处处相等' },
        { title: '并联电路', content: '1/R = 1/R₁+1/R₂，U 相同，I = I₁+I₂' },
        { title: '万有引力', content: 'F = GMm/r²' },
        { title: '动量', content: 'p = mv；碰撞前后动量守恒 Σp 前 = Σp 后' },
        { title: '安培力', content: 'F = BIL（B 磁感应强度，I 电流，L 导线长度）' }
      ]
    },
    {
      name: '化学常用计算',
      list: [
        { title: '物质的量', content: 'n = m/M（m 质量 g，M 摩尔质量 g/mol）' },
        { title: '粒子数', content: 'N = n × 6.02×10²³（阿伏加德罗常数）' },
        { title: '气体摩尔体积', content: 'V = n × 22.4 L/mol（标准状况下）' },
        { title: '物质的量浓度', content: 'c = n/V（V 为溶液体积，单位 L）' },
        { title: '质量分数', content: 'w = m溶质/m溶液 × 100%' },
        { title: '稀释定律', content: 'c₁V₁ = c₂V₂（稀释前后溶质的物质的量不变）' },
        { title: '浓度换算', content: 'c = 1000ρw/M（ρ 单位 g/mL，w 为质量分数）' },
        { title: '质量守恒定律', content: '参加反应的各物质质量总和 = 生成物质量总和' },
        { title: '化学反应速率', content: 'v = Δc/Δt（单位 mol/(L·s)）' },
        { title: 'pH 值', content: 'pH = -lg[H⁺]，[H⁺] 越大 pH 越小' },
        { title: '溶解度', content: 'S = m溶质/m溶剂 × 100g（一定温度下）' },
        { title: '化学方程式配平', content: '依据原子种类和数目不变，最小公倍数法' }
      ]
    }
  ]

  export default {
    private: {
      showList: false,
      catNames: [],
      currentName: '',
      formulaList: []
    },

    onInit() {
      var names = []
      for (var i = 0; i < CATEGORIES.length; i++) {
        names.push(CATEGORIES[i].name)
      }
      this.catNames = names
    },

    onBackPress() {
      if (this.showList) {
        this.backToCats()
        return true
      }
      router.back()
      return true
    },

    goBack() {
      router.back()
    },

    backToCats() {
      this.showList = false
      this.formulaList = []
    },

    selectCat(name) {
      var cat = null
      for (var i = 0; i < CATEGORIES.length; i++) {
        if (CATEGORIES[i].name === name) {
          cat = CATEGORIES[i]
          break
        }
      }
      if (!cat) return
      this.currentName = cat.name
      var arr = []
      for (var j = 0; j < cat.list.length; j++) {
        var f = cat.list[j]
        var lines = this.calcLines(f.content, 19, 368)
        var ch = lines * 26 + 4
        arr.push({ title: f.title, content: f.content, ch: ch, h: 52 + ch })
      }
      this.formulaList = arr
      this.showList = true
    },

    calcLines(str, fontSize, maxWidth) {
      if (!str) return 1
      var w = 0
      for (var i = 0; i < str.length; i++) {
        var code = str.charCodeAt(i)
        if (code > 0x2E7F) {
          w += fontSize
        } else {
          w += fontSize * 0.65
        }
      }
      return Math.min(8, Math.max(1, Math.ceil(w / maxWidth)))
    }
  }
</script>
