<template>
  <div class="page">
    <div class="title-bar">
      <text class="title-text">函数图像</text>
    </div>

    <div class="expr-box">
      <text class="expr-text">f(x)={{funcExpr}}</text>
    </div>

    <div class="graph-box">
      <!-- 网格线（横向） -->
      <div class="grid-h-line" for="{{gridH}}" style="top:{{$item}}px"></div>
      <!-- 网格线（纵向） -->
      <div class="grid-v-line" for="{{gridV}}" style="left:{{$item}}px"></div>
      <!-- 坐标轴 -->
      <div class="axis-v"></div>
      <div class="axis-h"></div>
      <!-- 函数曲线点 -->
      <div class="curve-dot" for="{{curveDots}}" style="left:{{$item.l}}px;top:{{$item.t}}px;background-color:{{$item.c}}"></div>
    </div>

    <text class="tip-text" if="{{hasError}}">表达式无效，请返回修改</text>
    <text class="tip-text" if="{{curveDots.length === 0 && !hasError}}">无法绘制该函数</text>
  </div>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .title-bar {
    width: 410px;
    height: 36px;
    margin-top: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .title-text {
    color: #ffffff;
    font-size: 28px;
    font-weight: 800;
  }

  .expr-box {
    width: 410px;
    height: 36px;
    border-radius: 18px;
    background-color: #1a1a1a;
    margin-top: 4px;
    padding-left: 14px;
    padding-right: 14px;
    display: flex;
    flex-direction: row;
    align-items: center;
  }

  .expr-text {
    width: 382px;
    height: 30px;
    color: #ffffff;
    font-size: 20px;
    font-weight: 800;
  }

  .graph-box {
    width: 410px;
    height: 340px;
    margin-top: 8px;
    border-radius: 20px;
    background-color: #0d0d0d;
    position: relative;
  }

  .grid-h-line {
    position: absolute;
    left: 0px;
    width: 410px;
    height: 1px;
    background-color: #1f1f1f;
  }

  .grid-v-line {
    position: absolute;
    top: 0px;
    width: 1px;
    height: 340px;
    background-color: #1f1f1f;
  }

  .axis-v {
    position: absolute;
    left: 205px;
    top: 0px;
    width: 2px;
    height: 340px;
    background-color: #666666;
  }

  .axis-h {
    position: absolute;
    left: 0px;
    top: 170px;
    width: 410px;
    height: 2px;
    background-color: #666666;
  }

  .curve-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
  }

  .tip-text {
    color: #ff6b6b;
    font-size: 18px;
    font-weight: 800;
    margin-top: 6px;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var GRAPH_EXPR_KEY = 'graph_expr_v2'

  export default {
    private: {
      funcExpr: '0',
      hasError: false,
      gridH: [],
      gridV: [],
      curveDots: [],
      vibrationOn: true,
      smoothOn: true
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
      storage.get({
        key: 'setting_smooth_curve',
        success: function(data) {
          self.smoothOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    onShow() {
      this.buildGrid()
      this.loadExpression()
    },

    buildGrid() {
      var gh = []
      var gv = []
      // 横向网格线，每 34px 一条
      for (var y = 0; y <= 340; y += 34) {
        gh.push(y)
      }
      // 纵向网格线，每 41px 一条
      for (var x = 0; x <= 410; x += 41) {
        gv.push(x)
      }
      this.gridH = gh
      this.gridV = gv
    },

    loadExpression() {
      var self = this
      storage.get({
        key: GRAPH_EXPR_KEY,
        success: function(data) {
          self.funcExpr = data || '0'
          self.generateCurve()
        },
        fail: function() {
          self.funcExpr = '0'
          self.generateCurve()
        }
      })
    },

    generateCurve() {
      var w = 410
      var cx = 205
      var cy = 170
      var scale = 30
      var dots = []
      var colors = ['#ffffff', '#ff6b6b', '#4ecdc4', '#ffd93d', '#6bcb77', '#c084fc']

      this.hasError = false

      try {
        var funcList = (this.funcExpr || '0').split(';')
        for (var fi = 0; fi < funcList.length; fi++) {
          var raw = funcList[fi]
          if (raw.replace(/ /g, '') === '') continue
          var expr = this.prepareExpression(raw)
          var color = colors[fi % colors.length]
          var step = this.smoothOn ? (w - 1) / 149 : 8
          for (var px = 0; px <= w - 1; px += step) {
            var x = (px - cx) / scale
            var y = this.evalExpression(expr, x)
            if (isNaN(y) || !isFinite(y) || Math.abs(y) > 1000) {
              continue
            }
            var py = cy - y * scale
            if (py < 0 || py > 340) {
              continue
            }
            dots.push({ l: Math.round(px), t: Math.round(py), c: color })
          }
        }
      } catch (e) {
        this.hasError = true
      }

      this.curveDots = dots
    },

    prepareExpression(expr) {
      var out = expr || '0'
      out = out.replace(/ /g, '')
      out = out.replace(/π/g, 'pi')
      out = out.replace(/÷/g, '/')
      out = out.replace(/×/g, '*')
      out = out.replace(/e\^x/g, 'exp(x)')
      out = out.replace(/e\^/g, 'exp(')
      out = this.replacePower(out)
      out = this.addImplicitMultiply(out)
      return out
    },

    replacePower(expr) {
      var out = expr
      out = out.replace(/x\^2/g, '(x^2)')
      out = out.replace(/x\^3/g, '(x^3)')
      return out
    },

    addImplicitMultiply(expr) {
      var out = expr
      out = out.replace(/([0-9.])x/g, '$1*x')
      out = out.replace(/x([0-9.])/g, 'x*$1')
      out = out.replace(/([0-9.])\(/g, '$1*(')
      out = out.replace(/\)([0-9.])/g, ')*$1')
      out = out.replace(/\)x/g, ')*x')
      out = out.replace(/x\(/g, 'x*(')
      out = out.replace(/([0-9.])(sin|cos|tan|sqrt|log|ln|lg|exp|abs)/g, '$1*$2')
      out = out.replace(/\)(sin|cos|tan|sqrt|log|ln|lg|exp|abs)/g, ')*$1')
      out = out.replace(/\)e/g, ')*e')
      out = out.replace(/e\(/g, 'e*(')
      out = out.replace(/([0-9.])e([^a-zA-Z])/g, '$1*e$2')
      out = out.replace(/([0-9.])e$/g, '$1*e')
      return out
    },

    evalExpression(expr, xValue) {
      var text = expr
      var index = 0

      function peek() {
        return text.charAt(index)
      }

      function eat(ch) {
        if (peek() === ch) {
          index++
          return true
        }
        return false
      }

      function parse() {
        var value = parseAddSub()
        if (index < text.length) {
          throw new Error('bad expr')
        }
        return value
      }

      function parseAddSub() {
        var value = parseMulDiv()
        while (index < text.length) {
          if (eat('+')) {
            value = value + parseMulDiv()
          } else if (eat('-')) {
            value = value - parseMulDiv()
          } else {
            break
          }
        }
        return value
      }

      function parseMulDiv() {
        var value = parsePower()
        while (index < text.length) {
          if (eat('*')) {
            value = value * parsePower()
          } else if (eat('/')) {
            value = value / parsePower()
          } else {
            break
          }
        }
        return value
      }

      function parsePower() {
        var value = parseUnary()
        if (eat('^')) {
          value = Math.pow(value, parsePower())
        }
        return value
      }

      function parseUnary() {
        if (eat('+')) return parseUnary()
        if (eat('-')) return -parseUnary()
        return parsePrimary()
      }

      function parsePrimary() {
        var ch = peek()
        if (eat('(')) {
          var value = parseAddSub()
          if (!eat(')')) {
            throw new Error('missing )')
          }
          return value
        }
        if ((ch >= '0' && ch <= '9') || ch === '.') {
          return parseNumber()
        }
        if (ch === 'x') {
          index++
          return xValue
        }
        return parseName()
      }

      function parseNumber() {
        var start = index
        while (index < text.length) {
          var ch = peek()
          if ((ch >= '0' && ch <= '9') || ch === '.') {
            index++
          } else {
            break
          }
        }
        return parseFloat(text.substring(start, index))
      }

      function parseName() {
        var start = index
        while (index < text.length) {
          var ch = peek()
          if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')) {
            index++
          } else {
            break
          }
        }
        var name = text.substring(start, index)
        if (name === 'pi') return Math.PI
        if (name === 'e') return Math.E
        if (!eat('(')) {
          throw new Error('bad name')
        }
        var arg = parseAddSub()
        if (!eat(')')) {
          throw new Error('missing )')
        }
        if (name === 'sin') return Math.sin(arg)
        if (name === 'cos') return Math.cos(arg)
        if (name === 'tan') return Math.tan(arg)
        if (name === 'sqrt') return Math.sqrt(arg)
        if (name === 'ln') return Math.log(arg)
        if (name === 'log') return Math.log(arg) / Math.LN10
        if (name === 'lg') return Math.log(arg) / Math.LN10
        if (name === 'exp') return Math.exp(arg)
        if (name === 'abs') return Math.abs(arg)
        throw new Error('unknown name')
      }

      return parse()
    }
  }
</script>
