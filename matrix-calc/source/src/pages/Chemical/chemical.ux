  }

  // ===== 规范化数据库key（按字母排序，确保任意输入顺序都能匹配）=====
  var SORTED_REACTION_DB = {}
  for (var rawKey in REACTION_DB) {
    if (REACTION_DB.hasOwnProperty(rawKey)) {
      var keyParts = rawKey.split('+')
      var keySorted = keyParts.slice().sort()
      var normKey = keySorted.join('+')
      SORTED_REACTION_DB[normKey] = REACTION_DB[rawKey]
    }
  }

  // ===== 常见气体与沉淀标记 =====
  var GAS_SYMBOLS = {
    'H2': '\u2191', 'O2': '\u2191', 'N2': '\u2191', 'CO2': '\u2191', 'CO': '\u2191',
    'SO2': '\u2191', 'SO3': '\u2191', 'NO': '\u2191', 'NO2': '\u2191', 'NH3': '\u2191',
    'H2S': '\u2191', 'Cl2': '\u2191', 'F2': '\u2191', 'O3': '\u2191',
    'CH4': '\u2191', 'C2H6': '\u2191', 'C3H8': '\u2191', 'C2H4': '\u2191', 'C2H2': '\u2191',
    'HF': '\u2191', 'HBr': '\u2191', 'HI': '\u2191', 'HCl': '\u2191'
  }
  var PRECIP_SYMBOLS = {
    'AgCl': '\u2193', 'BaSO4': '\u2193', 'CaCO3': '\u2193', 'BaCO3': '\u2193',
    'Cu(OH)2': '\u2193', 'Fe(OH)2': '\u2193', 'Fe(OH)3': '\u2193', 'Al(OH)3': '\u2193',
    'Mg(OH)2': '\u2193', 'CaSO4': '\u2193', 'BaSO3': '\u2193', 'CaSO3': '\u2193',
    'FeS': '\u2193', 'CuS': '\u2193', 'ZnS': '\u2193', 'PbS': '\u2193',
    'HgS': '\u2193', 'Ag2S': '\u2193', 'CaSiO3': '\u2193', 'H2SiO3': '\u2193',
    'S': '\u2193'
  }

  // ===== 分数运算 =====
  function gcdN(a, b) {
    a = Math.abs(a)
    b = Math.abs(b)
    while (b) {
      var t = b
      b = a % b
      a = t
    }
    return a || 1
  }

  function lcmN(a, b) {
    return Math.abs(a * b) / gcdN(a, b)
  }

  function F(num, den) {
    if (den === undefined) den = 1
    if (den === 0) den = 1
    if (den < 0) { num = -num; den = -den }
    var g = gcdN(num, den)
    return [num / g, den / g]
  }
  function Fadd(a, b) { return F(a[0] * b[1] + b[0] * a[1], a[1] * b[1]) }
  function Fsub(a, b) { return F(a[0] * b[1] - b[0] * a[1], a[1] * b[1]) }
  function Fmul(a, b) { return F(a[0] * b[0], a[1] * b[1]) }
  function Fdiv(a, b) { return F(a[0] * b[1], b[0] * a[1]) }
  function FisZero(a) { return a[0] === 0 }

  var LABELS = ['常见元素1', '常见元素2', '数字符号', '其他元素', '更多元素']
  var TOTAL = 5
  var CHEM_EXPR_KEY = 'chem_expr_v2'
  var HISTORY_KEY = 'calc_history_v2'

  export default {
    private: {
      expression: '',
      result: '等待输入',
      keyPage: 0,
      vibrationOn: true,
      autoCalcOn: true
    },

    computed: {
      displayExpression() {
        return this.expression === '' ? '化学方程式' : this.expression
      },
      currentLabel() {
        return LABELS[this.keyPage]
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
      storage.get({
        key: 'setting_autocalc',
        success: function(data) {
          self.autoCalcOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    prevPage() {
      this.doVibrate()
      this.keyPage = this.keyPage > 0 ? this.keyPage - 1 : TOTAL - 1
    },

    nextPage() {
      this.doVibrate()
      this.keyPage = this.keyPage < TOTAL - 1 ? this.keyPage + 1 : 0
    },

    pressKey(key) {
      this.doVibrate()
      this.expression += key
      this.refresh()
    },

    pressPlus() {
      this.doVibrate()
      if (this.expression === '') return
      var last = this.expression.charAt(this.expression.length - 1)
      if (last === '+' || last === '=') return
      this.expression += '+'
      this.refresh()
    },

    pressEqual() {
      this.doVibrate()
      if (this.expression === '') return
      if (this.expression.indexOf('=') !== -1) {
        this.refresh()
        this.saveHistoryIfBalanced()
        return
      }
      var last = this.expression.charAt(this.expression.length - 1)
      if (last === '+') return
      if (this.autoCalcOn) {
        var predicted = this.predictProducts(this.expression)
        if (predicted) {
          this.expression += '=' + predicted
        } else {
          this.expression += '='
        }
      } else {
        this.expression += '='
      }
      this.refresh()
      this.saveHistoryIfBalanced()
    },

    deleteLast() {
      this.doVibrate()
      if (this.expression.length > 0) {
        this.expression = this.expression.substring(0, this.expression.length - 1)
      }
      this.refresh()
    },

    clearAll() {
      this.doVibrate()
      this.expression = ''
      this.result = '等待输入'
    },

    openMore() {
      this.doVibrate()
      var expr = this.expression || ''
      storage.set({
        key: CHEM_EXPR_KEY,
        value: expr,
        success: function() {
          router.push({ uri: '/pages/ChemicalAnalysis' })
        },
        fail: function() {
          router.push({ uri: '/pages/ChemicalAnalysis' })
        }
      })
    },

    refresh() {
      if (this.expression === '') {
        this.result = '等待输入'
        return
      }
      if (this.expression.indexOf('=') === -1) {
        if (this.autoCalcOn) {
          var predicted = this.predictProducts(this.expression)
          if (predicted) {
            this.result = '\u2192 ' + predicted
          } else {
            this.result = '输入 = 配平'
          }
        } else {
          this.result = '输入 = 配平'
        }
        return
      }
      var eqParts = this.expression.split('=')
      if (eqParts.length === 2 && eqParts[1] === '') {
        if (this.autoCalcOn) {
          var predicted2 = this.predictProducts(eqParts[0])
          if (predicted2) {
            this.expression = eqParts[0] + '=' + predicted2
            var balanced = this.balanceEquation(this.expression)
            if (balanced) {
              this.result = balanced
            } else {
              this.result = '无法配平'
            }
          } else {
            this.result = '请输入生成物'
          }
        } else {
          this.result = '请输入生成物'
        }
        return
      }
      var balanced = this.balanceEquation(this.expression)
      if (balanced) {
        this.result = balanced
      } else {
        this.result = '无法配平'
      }
    },

    parseFormula(formula) {
      var result = this._parseFormulaRecursive(formula, 0)
      return result.counts
    },

    _parseFormulaRecursive(formula, start) {
      var counts = {}
      var i = start
      var n = formula.length
      while (i < n) {
        var ch = formula.charAt(i)
        if (ch === '(') {
          var sub = this._parseFormulaRecursive(formula, i + 1)
          i = sub.endIndex
          var mulStr = ''
          while (i < n) {
            var d2 = formula.charAt(i)
            if (d2 >= '0' && d2 <= '9') {
              mulStr += d2
              i++
            } else {
              break
            }
          }
          var multiplier = mulStr === '' ? 1 : parseInt(mulStr, 10)
          if (isNaN(multiplier)) multiplier = 1
          for (var elem in sub.counts) {
            if (sub.counts.hasOwnProperty(elem)) {
              counts[elem] = (counts[elem] || 0) + sub.counts[elem] * multiplier
            }
          }
        } else if (ch === ')') {
          return { counts: counts, endIndex: i + 1 }
        } else if (ch >= 'A' && ch <= 'Z') {
          var elem2 = ch
          i++
          if (i < n) {
            var nx = formula.charAt(i)
            if (nx >= 'a' && nx <= 'z') {
              elem2 += nx
              i++
            }
          }
          var numStr = ''
          while (i < n) {
            var d3 = formula.charAt(i)
            if (d3 >= '0' && d3 <= '9') {
              numStr += d3
              i++
            } else {
              break
            }
          }
          var count = numStr === '' ? 1 : parseInt(numStr, 10)
          if (isNaN(count)) count = 1
          counts[elem2] = (counts[elem2] || 0) + count
        } else {
          i++
        }
      }
      return { counts: counts, endIndex: i }
    },

    _stripCoeff(formula) {
      var k = 0
      while (k < formula.length && formula.charAt(k) >= '0' && formula.charAt(k) <= '9') k++
      return formula.substring(k)
    },

    predictProducts(reactantsStr) {
      if (!reactantsStr || reactantsStr === '') return null
      var parts = reactantsStr.split('+')
      var stripped = []
      for (var i = 0; i < parts.length; i++) {
        if (parts[i] === '') return null
        stripped.push(this._stripCoeff(parts[i]))
      }
      var unique = []
      var seen = {}
      for (var j = 0; j < stripped.length; j++) {
        if (!seen[stripped[j]]) {
          seen[stripped[j]] = true
          unique.push(stripped[j])
        }
      }
      var sorted = unique.slice().sort()
      var key = sorted.join('+')
      if (SORTED_REACTION_DB.hasOwnProperty(key)) {
        return SORTED_REACTION_DB[key]
      }
      return null
    },

    parseEquation(expr) {
      var eq = expr.replace(/->/g, '=').replace(/\u2192/g, '=').replace(/\s/g, '')
      var parts = eq.split('=')
      if (parts.length !== 2) return null
      var leftStr = parts[0]
      var rightStr = parts[1]
      if (leftStr === '' || rightStr === '') return null

      var self = this
      var parseSide = function(sideStr) {
        var formulas = sideStr.split('+')
        var res = []
        for (var i = 0; i < formulas.length; i++) {
          var f = formulas[i]
          if (f === '') return null
          var body = self._stripCoeff(f)
          if (body === '') return null
          var bodyClean = body.replace(/\(H2O\)/g, '').replace(/\(H2O\)\d*/g, '')
          if (bodyClean === '') bodyClean = body
          res.push({ formula: body, counts: self.parseFormula(body) })
        }
        return res
      }

      var reactants = parseSide(leftStr)
      var products = parseSide(rightStr)
      if (!reactants || !products) return null
      return { reactants: reactants, products: products }
    },

    balanceEquation(expr) {
      var parsed = this.parseEquation(expr)
      if (!parsed) return null

      var reactants = parsed.reactants
      var products = parsed.products
      var molecules = reactants.concat(products)
      var nMol = molecules.length

      var elemSet = {}
      var elemList = []
      for (var i = 0; i < nMol; i++) {
        var cs = molecules[i].counts
        for (var e in cs) {
          if (cs.hasOwnProperty(e) && !elemSet[e]) {
            elemSet[e] = true
            elemList.push(e)
          }
        }
      }
      var nElem = elemList.length

      var M = []
      for (var r = 0; r < nElem; r++) {
        var row = []
        for (var c = 0; c < nMol; c++) {
          var cnt = molecules[c].counts[elemList[r]] || 0
          var sign = c < reactants.length ? 1 : -1
          row.push(F(sign * cnt, 1))
        }
        M.push(row)
      }

      var pivotRow = []
      for (var c = 0; c < nMol; c++) pivotRow[c] = -1
      var pr = 0
      for (var c2 = 0; c2 < nMol && pr < nElem; c2++) {
        var piv = -1
        for (var i2 = pr; i2 < nElem; i2++) {
          if (!FisZero(M[i2][c2])) { piv = i2; break }
        }
        if (piv === -1) continue
        var tmp = M[pr]; M[pr] = M[piv]; M[piv] = tmp
        var pv = M[pr][c2]
        for (var j = 0; j < nMol; j++) M[pr][j] = Fdiv(M[pr][j], pv)
        for (var i3 = 0; i3 < nElem; i3++) {
          if (i3 !== pr && !FisZero(M[i3][c2])) {
            var factor = M[i3][c2]
            for (var j2 = 0; j2 < nMol; j2++) {
              M[i3][j2] = Fsub(M[i3][j2], Fmul(factor, M[pr][j2]))
            }
          }
        }
        pivotRow[c2] = pr
        pr++
      }

      var freeVars = []
      for (var c3 = 0; c3 < nMol; c3++) {
        if (pivotRow[c3] === -1) freeVars.push(c3)
      }

      if (freeVars.length === 0) return null

      var bestSol = null
      var bestMax = Infinity
      var nFree = freeVars.length

      // 尝试一组自由变量取值，计算完整解并验证
      function tryCombo(freeVals) {
        var sol = []
        for (var c4 = 0; c4 < nMol; c4++) sol.push(F(0, 1))
        for (var fv2 = 0; fv2 < nFree; fv2++) {
          sol[freeVars[fv2]] = F(freeVals[fv2], 1)
        }
        for (var c5 = 0; c5 < nMol; c5++) {
          if (pivotRow[c5] !== -1) {
            var rr = pivotRow[c5]
            var sum = F(0, 1)
            for (var j3 = 0; j3 < nMol; j3++) {
              if (pivotRow[j3] === -1) {
                sum = Fadd(sum, Fmul(M[rr][j3], sol[j3]))
              }
            }
            sol[c5] = Fmul(sum, F(-1, 1))
          }
        }

        var anyNonZero = false
        for (var c6 = 0; c6 < nMol; c6++) {
          if (!FisZero(sol[c6])) { anyNonZero = true; break }
        }
        if (!anyNonZero) return

        var denLcm = 1
        for (var c7 = 0; c7 < nMol; c7++) {
          denLcm = lcmN(denLcm, sol[c7][1])
        }
        var ints = []
        for (var c8 = 0; c8 < nMol; c8++) {
          ints.push(sol[c8][0] * (denLcm / sol[c8][1]))
        }
        var g = 0
        for (var c9 = 0; c9 < nMol; c9++) g = gcdN(g, Math.abs(ints[c9]))
        if (g === 0) g = 1
        for (var c10 = 0; c10 < nMol; c10++) ints[c10] = ints[c10] / g

        var negCount = 0
        for (var c11 = 0; c11 < nMol; c11++) if (ints[c11] < 0) negCount++
        if (negCount === nMol) {
          for (var c12 = 0; c12 < nMol; c12++) ints[c12] = -ints[c12]
        } else if (negCount > 0) {
          return
        }

        var hasZero = false
        for (var c13 = 0; c13 < nMol; c13++) {
          if (ints[c13] === 0) { hasZero = true; break }
        }
        if (hasZero) return

        var maxVal = 0
        for (var c14 = 0; c14 < nMol; c14++) {
          if (Math.abs(ints[c14]) > maxVal) maxVal = Math.abs(ints[c14])
        }
        if (maxVal < bestMax) {
          bestMax = maxVal
          bestSol = ints
        }
      }

      // 递归枚举所有自由变量的小整数组合（1~8）
      var maxVal = nFree <= 2 ? 12 : (nFree <= 3 ? 6 : 4)
      function searchIdx(idx, freeVals) {
        if (idx === nFree) {
          tryCombo(freeVals)
          return
        }
        for (var v = 1; v <= maxVal; v++) {
          freeVals[idx] = v
          searchIdx(idx + 1, freeVals)
        }
      }

      if (nFree <= 4) {
        searchIdx(0, [])
      } else {
        // 自由变量过多时回退到单变量尝试
        for (var fv = 0; fv < nFree; fv++) {
          var fvArr = []
          for (var fv3 = 0; fv3 < nFree; fv3++) {
            fvArr.push(fv === fv3 ? 1 : 0)
          }
          tryCombo(fvArr)
        }
      }

      if (!bestSol) return null

      if (!this.verifyBalance(reactants, products, bestSol)) return null

      return this.formatEquation(reactants, products, bestSol)
    },

    verifyBalance(reactants, products, coefs) {
      var elemSet = {}
      for (var i = 0; i < reactants.length; i++) {
        var cs = reactants[i].counts
        for (var e in cs) {
          if (cs.hasOwnProperty(e)) elemSet[e] = true
        }
      }
      for (var j = 0; j < products.length; j++) {
        var cs2 = products[j].counts
        for (var e2 in cs2) {
          if (cs2.hasOwnProperty(e2)) elemSet[e2] = true
        }
      }

      for (var elem in elemSet) {
        if (!elemSet.hasOwnProperty(elem)) continue
        var leftCount = 0
        for (var k = 0; k < reactants.length; k++) {
          leftCount += (reactants[k].counts[elem] || 0) * coefs[k]
        }
        var rightCount = 0
        for (var m = 0; m < products.length; m++) {
          rightCount += (products[m].counts[elem] || 0) * coefs[reactants.length + m]
        }
        if (leftCount !== rightCount) return false
      }
      return true
    },

    formatEquation(reactants, products, coefs) {
      var nR = reactants.length
      var leftParts = []
      for (var i = 0; i < nR; i++) {
        var co = coefs[i]
        leftParts.push((co === 1 ? '' : String(co)) + reactants[i].formula)
      }
      var rightParts = []
      for (var j = 0; j < products.length; j++) {
        var co2 = coefs[nR + j]
        var formula = products[j].formula
        var sym = ''
        if (GAS_SYMBOLS[formula]) sym = GAS_SYMBOLS[formula]
        else if (PRECIP_SYMBOLS[formula]) sym = PRECIP_SYMBOLS[formula]
        rightParts.push((co2 === 1 ? '' : String(co2)) + formula + sym)
      }
      return leftParts.join('+') + '=' + rightParts.join('+')
    },

    saveHistoryIfBalanced() {
      if (this.expression === '' || this.expression.indexOf('=') === -1) return
      if (this.result === '等待输入' || this.result === '无法配平' || this.result === '请输入生成物') return
      if (this.result.indexOf('\u2192') !== -1) return
      this.addHistory(this.expression, this.result)
    },

    addHistory(expr, result) {
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var list = []
          if (data) {
            try { list = JSON.parse(data) } catch (e) { list = [] }
          }
          list.push({ type: '化学方程式', expr: expr, result: result })
          if (list.length > 30) list = list.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(list) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: '化学方程式', expr: expr, result: result }]) })
        }
      })
    }
  }
</script>
