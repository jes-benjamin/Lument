    "CaO+H2O": "Ca(OH)2",
    "BaO+H2O": "Ba(OH)2",
    "SO2+O2": "SO3",
    "NO+O2": "NO2",

    // 置换反应
    "Fe+CuSO4": "Cu+FeSO4",
    "Zn+HCl": "H2+ZnCl2",
    "Zn+H2SO4": "H2+ZnSO4",
    "Fe+HCl": "H2+FeCl2",
