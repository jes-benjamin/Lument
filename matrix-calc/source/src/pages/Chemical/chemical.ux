<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  // ===== 常见化学反应数据库 =====
  // key: 反应物化学式按字母排序后用+连接（不含系数）
  // value: 生成物字符串
  var REACTION_DB = {
    // 燃烧反应
    "H2+O2": "H2O",
    "C+O2": "CO2",
    "CH4+O2": "CO2+H2O",
    "C2H6+O2": "CO2+H2O",
    "C3H8+O2": "CO2+H2O",
    "C2H4+O2": "CO2+H2O",
    "C2H2+O2": "CO2+H2O",
    "CO+O2": "CO2",

    // 分解反应
    "H2O": "H2+O2",
    "H2O2": "H2O+O2",
    "CaCO3": "CaO+CO2",
    "KClO3": "KCl+O2",
    "KMnO4": "K2MnO4+MnO2+O2",
    "NH4HCO3": "NH3+CO2+H2O",
    "H2CO3": "H2O+CO2",
    "H2SO3": "H2O+SO2",
    "Cu(OH)2": "CuO+H2O",
    "Fe(OH)3": "Fe2O3+H2O",
    "Al(OH)3": "Al2O3+H2O",
    "MgCO3": "MgO+CO2",
    "NaHCO3": "Na2CO3+H2O+CO2",

    // 化合反应
    "H2+Cl2": "HCl",
    "N2+H2": "NH3",
    "N2+O2": "NO",
    "Fe+S": "FeS",
    "C+CO2": "CO",
