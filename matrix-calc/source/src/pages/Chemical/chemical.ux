    "NaHCO3+HCl": "NaCl+H2O+CO2",
    "NaOH+CuSO4": "Cu(OH)2+Na2SO4",
    "NaOH+FeCl3": "Fe(OH)3+NaCl",
    "NaOH+FeCl2": "Fe(OH)2+NaCl",
    "NaOH+MgCl2": "Mg(OH)2+NaCl",
