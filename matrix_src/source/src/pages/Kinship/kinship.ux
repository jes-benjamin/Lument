    '爸爸的爸爸的妈妈': '太奶奶',
    '爸爸的妈妈的爸爸': '太外祖父',
    '爸爸的妈妈的妈妈': '太外祖母',
    '妈妈的爸爸的爸爸': '外太祖父',
    '妈妈的爸爸的妈妈': '外太祖母',
    '妈妈的妈妈的爸爸': '外太外祖父',
    '妈妈的妈妈的妈妈': '外太外祖母',

    // 父系旁系
    '爸爸的哥哥': '伯父',
    '爸爸的弟弟': '叔叔',
    '爸爸的姐姐': '姑姑',
    '爸爸的妹妹': '姑姑',
    '爸爸的哥哥的妻子': '伯母',
    '爸爸的弟弟的妻子': '婶婶',
    '爸爸的姐姐的丈夫': '姑父',
    '爸爸的妹妹的丈夫': '姑父',

    // 母系旁系
    '妈妈的兄弟': '舅舅',
    '妈妈的姐妹': '姨妈',
    '妈妈的哥哥': '舅舅',
    '妈妈的弟弟': '舅舅',
    '妈妈的姐姐': '大姨',
    '妈妈的妹妹': '小姨',
    '妈妈的兄弟的妻子': '舅妈',
    '妈妈的姐妹的丈夫': '姨父',
    '妈妈的哥哥的妻子': '舅妈',
    '妈妈的弟弟的妻子': '舅妈',
    '妈妈的姐姐的丈夫': '大姨父',
    '妈妈的妹妹的丈夫': '小姨父',

    // 同辈
    '哥哥': '哥哥',
    '弟弟': '弟弟',
    '姐姐': '姐姐',
    '妹妹': '妹妹',
    '哥哥的妻子': '嫂子',
    '弟弟的妻子': '弟媳',
    '姐姐的丈夫': '姐夫',
    '妹妹的丈夫': '妹夫',

    // 堂兄弟
    '爸爸的哥哥的儿子': '堂哥',
    '爸爸的弟弟的儿子': '堂弟',
    '爸爸的哥哥的女儿': '堂姐',
    '爸爸的弟弟的女儿': '堂妹',
    '爸爸的兄弟的儿子': '堂兄弟',
    '爸爸的兄弟的女儿': '堂姐妹',

    // 表亲
    '爸爸的姐妹的儿子': '表哥',
    '爸爸的姐妹的女儿': '表姐',
    '爸爸的姐姐的儿子': '表哥',
    '爸爸的姐姐的女儿': '表姐',
    '爸爸的妹妹的儿子': '表弟',
    '爸爸的妹妹的女儿': '表妹',
    '妈妈的兄弟的儿子': '表哥',
    '妈妈的兄弟的女儿': '表姐',
    '妈妈的姐妹的儿子': '表哥',
    '妈妈的姐妹的女儿': '表姐',
    '妈妈的哥哥的儿子': '表哥',
    '妈妈的哥哥的女儿': '表姐',
    '妈妈的弟弟的儿子': '表弟',
    '妈妈的弟弟的女儿': '表妹',
    '妈妈的姐姐的儿子': '表哥',
    '妈妈的姐姐的女儿': '表姐',
    '妈妈的妹妹的儿子': '表弟',
    '妈妈的妹妹的女儿': '表妹',

    // 配偶及配偶家人
    '丈夫': '丈夫',
    '妻子': '妻子',
    '丈夫的爸爸': '公公',
    '丈夫的妈妈': '婆婆',
    '妻子的爸爸': '岳父',
    '妻子的妈妈': '岳母',
    '丈夫的哥哥': '大伯子',
    '丈夫的弟弟': '小叔子',
    '丈夫的姐姐': '大姑子',
    '丈夫的妹妹': '小姑子',
    '妻子的哥哥': '大舅子',
    '妻子的弟弟': '小舅子',
    '妻子的姐姐': '大姨子',
    '妻子的妹妹': '小姨子',
    '妻子的姐姐的丈夫': '连襟',
    '妻子的妹妹的丈夫': '连襟',
    '丈夫的哥哥的妻子': '妯娌',
    '丈夫的弟弟的妻子': '妯娌',

    // 子辈
    '儿子': '儿子',
    '女儿': '女儿',
    '儿子的妻子': '儿媳妇',
    '女儿的丈夫': '女婿',
    '儿子的儿子': '孙子',
    '儿子的女儿': '孙女',
    '女儿的儿子': '外孙',
    '女儿的女儿': '外孙女',
    '儿子的儿子的儿子': '曾孙',
    '儿子的儿子的女儿': '曾孙女',

    // 侄甥辈
    '哥哥的儿子': '侄子',
    '弟弟的儿子': '侄子',
    '哥哥的女儿': '侄女',
    '弟弟的女儿': '侄女',
    '姐姐的儿子': '外甥',
    '妹妹的儿子': '外甥',
    '姐姐的女儿': '外甥女',
    '妹妹的女儿': '外甥女',

    // 堂表侄甥
    '堂哥的儿子': '堂侄',
    '堂弟的儿子': '堂侄',
    '堂哥的女儿': '堂侄女',
    '堂弟的女儿': '堂侄女',
    '表哥的儿子': '表侄',
    '表弟的儿子': '表侄',
    '表哥的女儿': '表侄女',
    '表弟的女儿': '表侄女',

    // 祖辈旁系
    '爸爸的爸爸的哥哥': '伯祖父',
    '爸爸的爸爸的弟弟': '叔祖父',
    '爸爸的爸爸的姐妹': '姑祖母',
    '爸爸的妈妈的兄弟': '舅祖父',
    '爸爸的妈妈的姐妹': '姨祖母',
    '妈妈的爸爸的兄弟': '外伯祖父',
    '妈妈的爸爸的姐妹': '外姑祖母',
    '妈妈的妈妈的兄弟': '外舅祖父',
    '妈妈的妈妈的姐妹': '外姨祖母'
  }

  export default {
    private: {
      rels: [],
      vibrationOn: true
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    computed: {
      chainText() {
        if (this.rels.length === 0) return '请选择关系'
        return this.rels.join('的')
      },

      resultText() {
        if (this.rels.length === 0) return '未选择'
        var key = this.rels.join('的')
        return MAP[key] || key
      }
    },

    onBackPress() {
      this.saveHistory()
      router.back()
      return true
    },

    addRel(name) {
      this.doVibrate()
      if (this.rels.length >= 4) return
      this.rels.push(name)
    },

    deleteLast() {
      this.doVibrate()
      if (this.rels.length > 0) this.rels.pop()
    },

    clearAll() {
      this.doVibrate()
      this.rels = []
    },

    saveHistory() {
      if (this.rels.length === 0) return
      this.addHistory('家族称谓', this.chainText, this.resultText)
    },

    addHistory(type, expr, result) {
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var list = []
          if (data) {
            try { list = JSON.parse(data) } catch (e) { list = [] }
          }
          list.push({ type: type, expr: expr, result: result })
          if (list.length > 30) list = list.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(list) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: type, expr: expr, result: result }]) })
        }
      })
    }
  }
</script>
