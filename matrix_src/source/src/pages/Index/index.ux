<template>
  <div class="page">
    <!-- 置顶栏背景 -->
    <div class="top-bar-bg"></div>

    <!-- 时钟 -->
    <text class="clock-text">{{currentTime}}</text>

    <!-- 标题 -->
    <text class="app-title">矩阵计算器</text>

    <!-- 菜单列表（可滚动） -->
    <list class="menu-list">
      <list-item class="section-header" if="{{hasPinned}}">
        <text class="section-text">置顶功能</text>
      </list-item>
      <list-item class="menu-item item-pinned" for="{{pinnedItems}}" tid="id" onclick="openItem($item)" onlongpress="togglePin($item)">
        <image class="menu-icon-img" if="{{$item.hasImg}}" src="{{$item.img}}"></image>
        <div class="menu-icon-box" if="{{$item.hasIcon}}"><text class="menu-icon-text">{{$item.icon}}</text></div>
        <text class="menu-text">{{$item.label}}</text>
        <text class="pin-badge">置顶</text>
      </list-item>
      <list-item class="section-header" if="{{hasPinned}}">
        <text class="section-text">全部功能</text>
      </list-item>
      <list-item class="menu-item" for="{{menuItems}}" tid="id" onclick="openItem($item)" onlongpress="togglePin($item)">
        <image class="menu-icon-img" if="{{$item.hasImg}}" src="{{$item.img}}"></image>
        <div class="menu-icon-box" if="{{$item.hasIcon}}"><text class="menu-icon-text">{{$item.icon}}</text></div>
        <text class="menu-text">{{$item.label}}</text>
      </list-item>
      <list-item class="menu-spacer">
        <text class="spacer-text"></text>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page {
    width: 336px;
    height: 480px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .top-bar-bg {
    width: 336px;
    height: 42px;
    position: absolute;
    top: 0px;
    left: 0px;
    z-index: 1;
    background-color: #000000;
  }

  .clock-text {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    margin-top: 10px;
    z-index: 2;
  }

  .app-title {
    color: #ffffff;
    font-size: 30px;
    font-weight: 800;
    margin-top: 2px;
    z-index: 2;
  }

  .menu-list {
    width: 320px;
    height: 340px;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }

  .menu-item {
    width: 320px;
    height: 100px;
    border-radius: 50px;
    background-color: rgba(147, 112, 219, 0.35);
    border-width: 3px;
    border-color: #9370db;
    margin-top: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 12px;
  }

  .menu-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 4px;
  }

  .menu-icon-img {
    width: 64px;
    height: 64px;
    margin-left: 4px;
  }

  .menu-icon-text {
    color: #ffffff;
    font-size: 32px;
    font-weight: 800;
    text-align: center;
  }

  .menu-text {
    color: #ffffff;
    font-size: 34px;
    font-weight: 800;
    margin-left: 16px;
  }

  .item-pinned {
    border-color: #6495ed;
    background-color: rgba(100, 149, 237, 0.35);
  }

  .pin-badge {
    color: #6495ed;
    font-size: 18px;
    font-weight: 800;
    margin-left: 8px;
  }

  .section-header {
    width: 320px;
    height: 36px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
  }

  .section-text {
    color: #9370db;
    font-size: 22px;
    font-weight: 800;
  }

  .menu-spacer {
    width: 320px;
    height: 60px;
  }

  .spacer-text {
    font-size: 1px;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import prompt from '@system.prompt'

  var PIN_KEY = 'index_pinned_v1'

  var MENU = [
    { id: 'standard', label: '标准计算器', img: '/Common/menu_standard.png', route: '/pages/Standard' },
    { id: 'scientific', label: '科学计算器', img: '/Common/menu_scientific.png', route: '/pages/Scientific' },
    { id: 'unit', label: '单位换算', img: '/Common/menu_unit.png', route: '/pages/Unit' },
    { id: 'graph', label: '函数图像', img: '/Common/menu_graph.png', route: '/pages/Graph' },
    { id: 'triangle', label: '三角几何', img: '/Common/menu_triangle.png', route: '/pages/Triangle' },
    { id: 'derivative', label: '求导函数值', img: '/Common/menu_derivative.png', route: '/pages/Derivative' },
    { id: 'monotonicity', label: '函数单调性计算', img: '/Common/menu_monotonicity.png', route: '/pages/Monotonicity' },
    { id: 'linearregression', label: '线性回归计算', img: '/Common/menu_linearregression.png', route: '/pages/LinearRegression' },
    { id: 'bmi', label: 'BMI计算', img: '/Common/menu_bmi.png', route: '/pages/BMI' },
    { id: 'currency', label: '货币换算', img: '/Common/menu_currency.png', route: '/pages/Currency' },
    { id: 'baseconverter', label: '进制转换', img: '/Common/menu_baseconverter.png', route: '/pages/BaseConverter' },
    { id: 'studytools', label: '公式大全', img: '/Common/menu_studytools.png', route: '/pages/Formulas' },
    { id: 'equation', label: '解方程', img: '/Common/menu_equation.png', route: '/pages/Equation' },
    { id: 'inequality', label: '解不等式', img: '/Common/menu_inequality.png', route: '/pages/Inequality' },
    { id: 'inequalitygroup', label: '解不等式组', img: '/Common/menu_inequalitygroup.png', route: '/pages/InequalityGroup' },
    { id: 'chemical', label: '化学方程式', img: '/Common/menu_chemical.png', route: '/pages/Chemical' },
    { id: 'kinship', label: '家族称谓计算', img: '/Common/menu_kinship.png', route: '/pages/Kinship' },
    { id: 'numbercase', label: '数字大小写转换', img: '/Common/menu_numbercase.png', route: '/pages/NumberCase' },
    { id: 'random', label: '随机数生成', img: '/Common/menu_random.png', route: '/pages/Random' },
    { id: 'history', label: '历史记录', img: '/Common/menu_history.png', route: '/pages/History' },
    { id: 'settings', label: '设置', img: '/Common/menu_settings.png', route: '/pages/Settings' }
  ]

  for (var mi = 0; mi < MENU.length; mi++) {
    MENU[mi].hasImg = !!MENU[mi].img
    MENU[mi].hasIcon = !MENU[mi].img
  }

  export default {
    private: {
      currentTime: '00:00',
      menuItems: MENU,
      pinnedItems: [],
      pinnedIds: [],
      hasPinned: false
    },

    onInit() {
      this.updateTime()
      this.timer = setInterval(this.updateTime.bind(this), 10000)
      this.loadPins()
    },

    onDestroy() {
      if (this.timer) {
        clearInterval(this.timer)
      }
    },

    updateTime() {
      var now = new Date()
      var h = now.getHours()
      var m = now.getMinutes()
      if (h < 10) h = '0' + h
      if (m < 10) m = '0' + m
      this.currentTime = h + ':' + m
    },

    loadPins() {
      var self = this
      storage.get({
        key: PIN_KEY,
        success: function(data) {
          if (data) {
            try {
              var ids = JSON.parse(data)
              if (ids && ids.length > 0) {
                self.pinnedIds = ids
                self.rebuildPinned()
              }
            } catch (e) {}
          }
        }
      })
    },

    rebuildPinned() {
      var pinned = []
      for (var i = 0; i < this.pinnedIds.length; i++) {
        for (var j = 0; j < MENU.length; j++) {
          if (MENU[j].id === this.pinnedIds[i]) {
            pinned.push(MENU[j])
            break
          }
        }
      }
      this.pinnedItems = pinned
      this.hasPinned = pinned.length > 0
    },

    togglePin(item) {
      var id = item.id
      var idx = this.pinnedIds.indexOf(id)
      if (idx >= 0) {
        this.pinnedIds.splice(idx, 1)
        prompt.showToast({ message: '已取消置顶' })
      } else {
        this.pinnedIds.push(id)
        prompt.showToast({ message: '已置顶：' + item.label })
      }
      this.rebuildPinned()
      storage.set({
        key: PIN_KEY,
        value: JSON.stringify(this.pinnedIds)
      })
    },

    openItem(item) {
      router.push({ uri: item.route })
    }
  }
</script>
