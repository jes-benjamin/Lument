<template>
  <div class="page">
    <div class="display-box">
      <text class="expr-text">{{displayExpression}}</text>
      <text class="result-text">{{result}}</text>
    </div>

    <list class="kb-list">
      <list-item class="kb-section" type="section">
        <text class="kb-section-text">数字输入</text>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-num" onclick="pressChar('7')"><text class="num-text">7</text></div>
        <div class="key key-num" onclick="pressChar('8')"><text class="num-text">8</text></div>
        <div class="key key-num" onclick="pressChar('9')"><text class="num-text">9</text></div>
        <div class="key key-soft" onclick="deleteLast"><text class="func-text">DEL</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-num" onclick="pressChar('4')"><text class="num-text">4</text></div>
        <div class="key key-num" onclick="pressChar('5')"><text class="num-text">5</text></div>
        <div class="key key-num" onclick="pressChar('6')"><text class="num-text">6</text></div>
        <div class="key key-soft" onclick="clearAll"><text class="func-text">AC</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-num" onclick="pressChar('1')"><text class="num-text">1</text></div>
        <div class="key key-num" onclick="pressChar('2')"><text class="num-text">2</text></div>
        <div class="key key-num" onclick="pressChar('3')"><text class="num-text">3</text></div>
        <div class="key key-equal" onclick="pressChar('=')"><text class="num-dark">=</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-num" onclick="pressChar('.')"><text class="num-text">.</text></div>
        <div class="key key-num" onclick="pressChar('0')"><text class="num-text">0</text></div>
        <div class="key key-num" onclick="pressChar('x')"><text class="num-text">x</text></div>
        <div class="key-solve" onclick="solve"><text class="solve-text">计算</text></div>
      </list-item>

      <list-item class="kb-section" type="section">
        <text class="kb-section-text">运算符号</text>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-op" onclick="pressChar('+')"><text class="num-text">+</text></div>
        <div class="key key-op" onclick="pressChar('-')"><text class="num-text">&#8722;</text></div>
        <div class="key key-op" onclick="pressChar('*')"><text class="num-text">&#215;</text></div>
        <div class="key key-soft" onclick="deleteLast"><text class="func-text">DEL</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-op" onclick="pressChar('/')"><text class="num-text">&#247;</text></div>
        <div class="key key-op" onclick="pressChar('^')"><text class="num-text">^</text></div>
        <div class="key key-soft" onclick="pressChar('(')"><text class="num-text">(</text></div>
        <div class="key key-soft" onclick="pressChar(')')"><text class="num-text">)</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-num" onclick="pressChar('e')"><text class="num-text">e</text></div>
        <div class="key key-num" onclick="pressChar('&#960;')"><text class="num-text">&#960;</text></div>
        <div class="key key-equal" onclick="pressChar('=')"><text class="num-dark">=</text></div>
        <div class="key key-soft" onclick="clearAll"><text class="func-text">AC</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key-solve" onclick="solve"><text class="solve-text">计算</text></div>
      </list-item>

      <list-item class="kb-section" type="section">
        <text class="kb-section-text">函数符号</text>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-soft" onclick="pressChar('sin')"><text class="func-text">sin</text></div>
        <div class="key key-soft" onclick="pressChar('cos')"><text class="func-text">cos</text></div>
        <div class="key key-soft" onclick="pressChar('tan')"><text class="func-text">tan</text></div>
        <div class="key key-soft" onclick="deleteLast"><text class="func-text">DEL</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-soft" onclick="pressChar('log')"><text class="func-text">log</text></div>
        <div class="key key-soft" onclick="pressChar('ln')"><text class="func-text">ln</text></div>
        <div class="key key-soft" onclick="pressChar('lg')"><text class="func-text">lg</text></div>
        <div class="key key-soft" onclick="clearAll"><text class="func-text">AC</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-soft" onclick="pressChar('&#8730;')"><text class="func-text">&#8730;</text></div>
        <div class="key key-soft" onclick="pressChar('|x|')"><text class="func-text">|x|</text></div>
        <div class="key key-soft" onclick="pressChar('e^x')"><text class="func-text">e&#8319;</text></div>
        <div class="key key-num" onclick="pressChar('&#960;')"><text class="num-text">&#960;</text></div>
      </list-item>
      <list-item class="key-row" type="row">
        <div class="key key-num" onclick="pressChar('e')"><text class="num-text">e</text></div>
        <div class="key key-num" onclick="pressChar('x')"><text class="num-text">x</text></div>
        <div class="key key-equal" onclick="pressChar('=')"><text class="num-dark">=</text></div>
        <div class="key key-op" onclick="solve"><text class="num-text">计算</text></div>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page {
    width: 336px;
    height: 480px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .display-box {
    width: 300px;
    height: 76px;
    border-radius: 18px;
    background-color: #1a1a1a;
    margin-top: 8px;
    padding: 6px 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
  }

  .expr-text {
    width: 272px;
    height: 20px;
    color: #888888;
    font-size: 14px;
    text-align: right;
  }

  .result-text {
    width: 272px;
    height: 44px;
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
    text-align: right;
  }

  .kb-list {
    width: 336px;
    height: 396px;
    margin-top: 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kb-section {
    width: 320px;
    height: 22px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .kb-section-text {
    color: #888888;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }

  .key-row {
    width: 320px;
    height: 58px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .key {
    width: 74px;
    height: 52px;
    margin-left: 3px;
    margin-right: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-solve {
    width: 74px;
    height: 52px;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 24px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-num {
    border-radius: 26px;
    background-color: rgba(128, 128, 128, 0.35);
    border-width: 2px;
    border-color: #888888;
  }

  .key-soft {
    border-radius: 24px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
  }

  .key-op {
    border-radius: 24px;
    background-color: rgba(147, 112, 219, 0.35);
    border-width: 2px;
    border-color: #9370db;
  }

  .key-equal {
    border-radius: 24px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
  }

  .num-text {
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
  }

  .num-dark {
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
  }

  .func-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
  }

  .solve-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var HISTORY_KEY = 'calc_history_v2'

  export default {
    private: {
      expression: '',
      result: '等待输入',
      vibrationOn: true,
      xValue: 0
    },

    computed: {
      displayExpression() {
        return this.expression || '输入函数如: x^2-4x+3'
      }
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    clearAll() {
      this.doVibrate()
      this.expression = ''
      this.result = '等待输入'
    },

    deleteLast() {
      this.doVibrate()
      if (this.expression.length > 0) {
        this.expression = this.expression.substring(0, this.expression.length - 1)
      }
      if (this.expression.length === 0) {
        this.result = '等待输入'
      }
    },

    pressChar(ch) {
      this.doVibrate()
      if (this.result !== '等待输入' && this.result !== '请输入表达式') {
        this.expression = ''
        this.result = '等待输入'
      }
      if (ch === 'sin' || ch === 'cos' || ch === 'tan' || ch === 'log' || ch === 'ln' || ch === 'lg') {
        this.expression += ch + '('
      } else if (ch === '√') {
        this.expression += '√('
      } else if (ch === '|x|') {
        this.expression += 'abs('
      } else if (ch === 'e^x') {
        this.expression += 'e^x'
      } else {
        this.expression += ch
      }
    },

    solve() {
      this.doVibrate()
      var raw = this.expression.replace(/\s/g, '')
      if (raw.length === 0) {
        this.result = '请输入表达式'
        return
      }

      try {
        if (this.isPolynomial(raw)) {
          this.result = this.findMonotonicityPoly(raw)
        } else {
          this.result = this.sampleMonotonicity(raw)
        }
        this.addHistory(this.expression, this.result)
      } catch (e) {
        this.result = '无法解析'
      }
    },

    isPolynomial(expr) {
      var s = expr.replace(/\s/g, '')
      for (var i = 0; i < s.length; i++) {
        var c = s.charAt(i)
        if (!((c >= '0' && c <= '9') || c === 'x' || c === '+' || c === '-' || c === '*' || c === '/' || c === '^' || c === '(' || c === ')' || c === '.')) {
          return false
        }
      }
      return true
    },

    findMonotonicityPoly(expr) {
      var tokens = this.tokenize(expr)
      var result = this.parseExprRD(tokens, 0)
      var coeffs = result.coeffs

      var deriv = {}
      for (var key in coeffs) {
        if (coeffs.hasOwnProperty(key) && key !== 'const') {
          var deg = parseInt(key.substring(1))
          var newDeg = deg - 1
          var newKey = newDeg === 0 ? 'const' : 'x' + newDeg
          deriv[newKey] = (deriv[newKey] || 0) + coeffs[key] * deg
        }
      }

      var nonZero = []
      for (var k in deriv) {
        if (deriv.hasOwnProperty(k) && Math.abs(deriv[k]) > 1e-9) {
          nonZero.push({ key: k, val: deriv[k] })
        }
      }

      if (nonZero.length === 0) {
        return '函数为常数'
      }

      var maxDeg = 0
      for (var i = 0; i < nonZero.length; i++) {
        var d = nonZero[i].key === 'const' ? 0 : parseInt(nonZero[i].key.substring(1))
        if (d > maxDeg) maxDeg = d
      }

      var roots = []
      if (maxDeg === 0) {
        var c = deriv.const || 0
        return c > 0 ? '(-\u221e,+\u221e)递增' : '(-\u221e,+\u221e)递减'
      } else if (maxDeg === 1) {
        var a = deriv.x1 || 0
        var b = deriv.const || 0
        if (Math.abs(a) > 1e-9) {
          roots.push(-b / a)
        }
      } else if (maxDeg === 2) {
        var a2 = deriv.x2 || 0
        var b2 = deriv.x1 || 0
        var c2 = deriv.const || 0
        var disc = b2 * b2 - 4 * a2 * c2
        var eps = 1e-9
        if (disc > eps) {
          var r1 = (-b2 - Math.sqrt(disc)) / (2 * a2)
          var r2 = (-b2 + Math.sqrt(disc)) / (2 * a2)
          if (r1 > r2) { var tmp = r1; r1 = r2; r2 = tmp }
          roots.push(r1)
          roots.push(r2)
        } else if (Math.abs(disc) <= eps) {
          roots.push(-b2 / (2 * a2))
        } else {
          if (a2 > 0) return '(-\u221e,+\u221e)递增'
          else return '(-\u221e,+\u221e)递减'
        }
      } else {
        return this.sampleMonotonicity(expr)
      }

      var parts = []
      var startLabel = '-\u221e'
      var prevSign = 0

      for (var i = 0; i <= roots.length; i++) {
        var testX
        if (i === 0) {
          testX = roots[0] - 1
        } else if (i === roots.length) {
          testX = roots[roots.length - 1] + 1
        } else {
          testX = (roots[i - 1] + roots[i]) / 2
        }

        var derivVal = this.evaluatePolynomial(deriv, testX)
        var isInc = derivVal > 0
        var endLabel = (i === roots.length) ? '+\u221e' : this.formatNum(roots[i])

        if (isInc) {
          parts.push('(' + startLabel + ',' + endLabel + ')递增')
        } else {
          parts.push('(' + startLabel + ',' + endLabel + ')递减')
        }

        startLabel = endLabel
      }

      return parts.join(',')
    },

    evaluatePolynomial(coeffs, x) {
      var val = 0
      for (var key in coeffs) {
        if (coeffs.hasOwnProperty(key)) {
          if (key === 'const') {
            val += coeffs[key]
          } else {
            var deg = parseInt(key.substring(1))
            val += coeffs[key] * Math.pow(x, deg)
          }
        }
      }
      return val
    },

    sampleMonotonicity(expr) {
      var self = this
      var eps = 1e-7
      var tokens = this.tokenizeGeneral(expr)

      var f = function(x) {
        try {
          self.xValue = x
          var v = self.parseExprVal(tokens, 0).value
          return isFinite(v) ? v : NaN
        } catch (e) { return NaN }
      }
      var deriv = function(x) {
        var h = 1e-5
        var f1 = f(x + h)
        var f2 = f(x - h)
        if (isNaN(f1) || isNaN(f2)) return NaN
        return (f1 - f2) / (2 * h)
      }
      var sgn = function(d) {
        if (isNaN(d)) return 0
        return d > eps ? 1 : (d < -eps ? -1 : 0)
      }

      var xs = []
      for (var xi = -400; xi <= 400; xi++) {
        xs.push(xi * 0.05)
      }

      var samples = []
      for (var i = 0; i < xs.length; i++) {
        var y = deriv(xs[i])
        samples.push({ x: xs[i], y: y, s: sgn(y) })
      }

      var first = 0
      while (first < samples.length && samples[first].s === 0) first++
      if (first === samples.length) {
        return '非单调函数'
      }

      var prevS = samples[first].s
      var transitions = []
      for (var i2 = first + 1; i2 < samples.length; i2++) {
        var s = samples[i2].s
        if (s === 0) continue
        if (s !== prevS) {
          var lo = samples[i2 - 1].x
          var hi = samples[i2].x
          var flo = deriv(lo)
          if (sgn(flo) === 0) {
            for (var j = i2 - 1; j >= 0; j--) {
              if (samples[j].s !== 0) { lo = samples[j].x; flo = samples[j].y; break }
            }
          }
          for (var iter = 0; iter < 30; iter++) {
            var m = (lo + hi) / 2
            var fm = deriv(m)
            if (sgn(fm) === sgn(flo) || isNaN(fm)) lo = m
            else hi = m
          }
          var r = (lo + hi) / 2
          if (transitions.length === 0 || Math.abs(transitions[transitions.length - 1] - r) > 0.02) {
            transitions.push(r)
          }
          prevS = s
        }
      }

      if (transitions.length === 0) {
        return prevS > 0 ? '(-∞,+∞)递增' : '(-∞,+∞)递减'
      }

      var bounds = [-Infinity].concat(transitions).concat([Infinity])
      var parts = []
      for (var t = 0; t < bounds.length - 1; t++) {
        var loB = bounds[t]
        var hiB = bounds[t + 1]
        var mid
        if (!isFinite(loB)) mid = hiB - 1
        else if (!isFinite(hiB)) mid = loB + 1
        else mid = (loB + hiB) / 2
        var d = deriv(mid)
        var startL = t === 0 ? '-∞' : this.formatNum(loB)
        var endL = t === bounds.length - 2 ? '+∞' : this.formatNum(hiB)
        parts.push('(' + startL + ',' + endL + ')' + (d > 0 ? '递增' : '递减'))
      }

      return parts.join(',')
    },

    numericalDerivative(expr, x0) {
      var h = 1e-5
      this.xValue = x0 + h
      var tokens1 = this.tokenizeGeneral(expr)
      var f1 = this.parseExprVal(tokens1, 0).value

      this.xValue = x0 - h
      var tokens2 = this.tokenizeGeneral(expr)
      var f2 = this.parseExprVal(tokens2, 0).value

      return (f1 - f2) / (2 * h)
    },

    // ===== 通用表达式求值 =====
    tokenizeGeneral(s) {
      var tokens = []
      var i = 0
      while (i < s.length) {
        var ch = s.charAt(i)
        if (ch === ' ' || ch === '\t') { i++; continue }

        if (ch >= 'a' && ch <= 'z') {
          var word = ''
          while (i < s.length && s.charAt(i) >= 'a' && s.charAt(i) <= 'z') {
            word += s.charAt(i)
            i++
          }
          tokens.push(word)
          continue
        }

        if (ch === '√') {
          tokens.push('sqrt')
          i++
          continue
        }

        if (ch === '\u03c0') {
          tokens.push('\u03c0')
          i++
          continue
        }

        if (ch === '+' || ch === '-' || ch === '*' || ch === '/' || ch === '(' || ch === ')' || ch === '^') {
          if (ch === '-' && (tokens.length === 0 || tokens[tokens.length - 1] === '(' || tokens[tokens.length - 1] === '+' || tokens[tokens.length - 1] === '-' || tokens[tokens.length - 1] === '*' || tokens[tokens.length - 1] === '/')) {
            var num = '-'
            i++
            while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
              num += s.charAt(i)
              i++
            }
            tokens.push(num)
            continue
          }
          tokens.push(ch)
          i++
        } else if (ch === '^') {
          tokens.push(ch)
          i++
        } else if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num2 = ''
          while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
            num2 += s.charAt(i)
            i++
          }
          tokens.push(num2)
        } else {
          i++
        }
      }
      return tokens
    },

    parseExprVal(tokens, pos) {
      var res = this.parseTermVal(tokens, pos)
      var val = res.value
      var i = res.pos
      while (i < tokens.length && (tokens[i] === '+' || tokens[i] === '-')) {
        var op = tokens[i]
        var termRes = this.parseTermVal(tokens, i + 1)
        if (op === '+') val += termRes.value
        else val -= termRes.value
        i = termRes.pos
      }
      return { value: val, pos: i }
    },

    parseTermVal(tokens, pos) {
      var res = this.parseFactorVal(tokens, pos)
      var val = res.value
      var i = res.pos
      while (i < tokens.length) {
        if (tokens[i] === '*' || tokens[i] === '/') {
          var op = tokens[i]
          var factorRes = this.parseFactorVal(tokens, i + 1)
          if (op === '*') val *= factorRes.value
          else val /= factorRes.value
          i = factorRes.pos
        } else if (tokens[i] === '+' || tokens[i] === '-') {
          break
        } else if (tokens[i] === ')') {
          break
        } else {
          var factorRes2 = this.parseFactorVal(tokens, i)
          val *= factorRes2.value
          i = factorRes2.pos
        }
      }
      return { value: val, pos: i }
    },

    parseFactorVal(tokens, pos) {
      if (pos >= tokens.length) return { value: 0, pos: pos }

      if (tokens[pos] === '-') {
        var res = this.parseFactorVal(tokens, pos + 1)
        return { value: -res.value, pos: res.pos }
      }

      var primaryRes = this.parsePrimaryVal(tokens, pos)
      var val = primaryRes.value
      var i = primaryRes.pos

      if (i < tokens.length && tokens[i] === '^') {
        var expRes = this.parseFactorVal(tokens, i + 1)
        val = Math.pow(val, expRes.value)
        i = expRes.pos
      }

      return { value: val, pos: i }
    },

    parsePrimaryVal(tokens, pos) {
      if (pos >= tokens.length) return { value: 0, pos: pos }
      var t = tokens[pos]

      if (t === '(') {
        var exprRes = this.parseExprVal(tokens, pos + 1)
        var endPos = exprRes.pos
        if (endPos < tokens.length && tokens[endPos] === ')') endPos++
        return { value: exprRes.value, pos: endPos }
      }

      if (t === 'x') return { value: this.xValue, pos: pos + 1 }
      if (t === 'e') return { value: Math.E, pos: pos + 1 }
      if (t === '\u03c0') return { value: Math.PI, pos: pos + 1 }

      if (t === 'sin' || t === 'cos' || t === 'tan' || t === 'log' || t === 'ln' || t === 'lg' || t === 'sqrt' || t === 'abs') {
        var nextPos = pos + 1
        if (nextPos < tokens.length && tokens[nextPos] === '(') {
          var argRes = this.parseExprVal(tokens, nextPos + 1)
          var argVal = argRes.value
          var afterArg = argRes.pos
          if (afterArg < tokens.length && tokens[afterArg] === ')') afterArg++
          var funcVal
          if (t === 'sin') funcVal = Math.sin(argVal)
          else if (t === 'cos') funcVal = Math.cos(argVal)
          else if (t === 'tan') funcVal = Math.tan(argVal)
          else if (t === 'ln') funcVal = Math.log(argVal)
          else if (t === 'log') funcVal = Math.log10(argVal)
          else if (t === 'lg') funcVal = Math.log(argVal) / Math.LN10
          else if (t === 'sqrt') funcVal = Math.sqrt(argVal)
          else if (t === 'abs') funcVal = Math.abs(argVal)
          return { value: funcVal, pos: afterArg }
        }
        return { value: 0, pos: pos + 1 }
      }

      var num = parseFloat(t)
      if (!isNaN(num)) {
        return { value: num, pos: pos + 1 }
      }

      return { value: 0, pos: pos + 1 }
    },

    // ===== 多项式解析器 =====
    parsePolynomial(s) {
      var tokens = this.tokenize(s)
      var result = this.parseExprRD(tokens, 0)
      return result.coeffs
    },

    parseExprRD(tokens, pos) {
      var sign = 1
      if (pos < tokens.length && tokens[pos] === '-') {
        sign = -1
        pos++
      } else if (pos < tokens.length && tokens[pos] === '+') {
        pos++
      }
      var res = this.parseTerm(tokens, pos)
      var coeffs = res.coeffs
      if (sign === -1) {
        for (var key in coeffs) {
          if (coeffs.hasOwnProperty(key)) {
            coeffs[key] = -coeffs[key]
          }
        }
      }
      var i = res.pos
      while (i < tokens.length && (tokens[i] === '+' || tokens[i] === '-')) {
        var op = tokens[i]
        var termRes = this.parseTerm(tokens, i + 1)
        for (var key2 in termRes.coeffs) {
          var val = termRes.coeffs[key2]
          if (op === '-') val = -val
          coeffs[key2] = (coeffs[key2] || 0) + val
        }
        i = termRes.pos
      }
      return { coeffs: coeffs, pos: i }
    },

    parseTerm(tokens, pos) {
      var res = this.parseFactor(tokens, pos)
      var coeffs = res.coeffs
      var i = res.pos
      while (i < tokens.length) {
        if (tokens[i] === '*' || tokens[i] === '/') {
          var op = tokens[i]
          var factorRes = this.parseFactor(tokens, i + 1)
          if (op === '*') {
            coeffs = this.multiplyPoly(coeffs, factorRes.coeffs)
          } else {
            coeffs = this.dividePoly(coeffs, factorRes.coeffs)
          }
          i = factorRes.pos
        } else if (tokens[i] === '(' || tokens[i] === 'x' || tokens[i] === 'y') {
          var factorRes2 = this.parseFactor(tokens, i)
          coeffs = this.multiplyPoly(coeffs, factorRes2.coeffs)
          i = factorRes2.pos
        } else {
          break
        }
      }
      return { coeffs: coeffs, pos: i }
    },

    parseFactor(tokens, pos) {
      if (pos >= tokens.length) return { coeffs: {}, pos: pos }
      var t = tokens[pos]

      if (t === '(') {
        var exprRes = this.parseExprRD(tokens, pos + 1)
        var endPos = exprRes.pos
        if (endPos < tokens.length && tokens[endPos] === ')') {
          endPos++
        }
        return { coeffs: exprRes.coeffs, pos: endPos }
      }

      if (t === 'x' || t === 'y') {
        var coeff = 1
        if (pos + 1 < tokens.length && tokens[pos + 1] === '^') {
          var power = parseInt(tokens[pos + 2])
          if (!isNaN(power) && power >= 1) {
            var key = t + power
            var obj = {}
            obj[key] = coeff
            return { coeffs: obj, pos: pos + 3 }
          }
        }
        var obj2 = {}
        obj2[t + '1'] = coeff
        return { coeffs: obj2, pos: pos + 1 }
      }

      var num = parseFloat(t)
      if (!isNaN(num)) {
        if (pos + 1 < tokens.length && (tokens[pos + 1] === 'x' || tokens[pos + 1] === 'y')) {
          var varToken = tokens[pos + 1]
          var varCoeff = num
          if (pos + 2 < tokens.length && tokens[pos + 2] === '^') {
            var varPower = parseInt(tokens[pos + 3])
            if (!isNaN(varPower) && varPower >= 1) {
              var obj3 = {}
              obj3[varToken + varPower] = varCoeff
              return { coeffs: obj3, pos: pos + 4 }
            }
          }
          var obj4 = {}
          obj4[varToken + '1'] = varCoeff
          return { coeffs: obj4, pos: pos + 2 }
        }
        return { coeffs: { const: num }, pos: pos + 1 }
      }

      return { coeffs: {}, pos: pos + 1 }
    },

    multiplyPoly(c1, c2) {
      var result = {}
      for (var k1 in c1) {
        if (!c1.hasOwnProperty(k1)) continue
        for (var k2 in c2) {
          if (!c2.hasOwnProperty(k2)) continue
          var v = c1[k1] * c2[k2]
          var deg1 = k1 === 'const' ? 0 : parseInt(k1.substring(1))
          var deg2 = k2 === 'const' ? 0 : parseInt(k2.substring(1))
          var newDeg = deg1 + deg2
          var newKey = newDeg === 0 ? 'const' : 'x' + newDeg
          result[newKey] = (result[newKey] || 0) + v
        }
      }
      return result
    },

    dividePoly(c1, c2) {
      var keys = Object.keys(c2)
      if (keys.length === 1 && keys[0] === 'const') {
        var divisor = c2.const
        if (divisor === 0) return c1
        var result = {}
        for (var k in c1) {
          if (c1.hasOwnProperty(k)) {
            result[k] = c1[k] / divisor
          }
        }
        return result
      }
      return c1
    },

    tokenize(s) {
      var tokens = []
      var i = 0
      while (i < s.length) {
        var ch = s.charAt(i)
        if (ch === '+' || ch === '-' || ch === '*' || ch === '/' || ch === '(' || ch === ')') {
          if (ch === '-' && (tokens.length === 0 || tokens[tokens.length - 1] === '(' || tokens[tokens.length - 1] === '+' || tokens[tokens.length - 1] === '-' || tokens[tokens.length - 1] === '*' || tokens[tokens.length - 1] === '/')) {
            var num = '-'
            i++
            while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
              num += s.charAt(i)
              i++
            }
            tokens.push(num)
            continue
          }
          tokens.push(ch)
          i++
        } else if (ch === '^') {
          tokens.push(ch)
          i++
        } else if ((ch >= '0' && ch <= '9') || ch === '.') {
          var num2 = ''
          while (i < s.length && ((s.charAt(i) >= '0' && s.charAt(i) <= '9') || s.charAt(i) === '.')) {
            num2 += s.charAt(i)
            i++
          }
          tokens.push(num2)
        } else if (ch === 'x' || ch === 'y') {
          tokens.push(ch)
          i++
        } else {
          i++
        }
      }
      return tokens
    },

    formatNum(n) {
      var rounded = Math.round(n * 100000) / 100000
      if (Math.abs(rounded - Math.round(rounded)) < 0.000001) {
        return String(Math.round(rounded))
      }
      var str = String(rounded)
      if (str.length > 10) {
        str = rounded.toExponential(4)
      }
      return str
    },

    addHistory(expr, result) {
      var type = '单调性'
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var list = []
          if (data) {
            try { list = JSON.parse(data) } catch (e) { list = [] }
          }
          list.push({ type: type, expr: expr, result: result })
          if (list.length > 30) list = list.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(list) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: type, expr: expr, result: result }]) })
        }
      })
    }
  }
</script>
