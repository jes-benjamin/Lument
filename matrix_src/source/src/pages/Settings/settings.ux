<template>
  <div class="page">
    <div class="header-bar">
      <text class="header-title">设置</text>
    </div>

    <list class="settings-list">
      <list-item class="setting-item" type="toggle" onclick="toggleVibration">
        <text class="setting-label">按键震动反馈</text>
        <image class="toggle-img" src="{{vibrationOn ? '/Common/toggle_on.png' : '/Common/toggle_off.png'}}"></image>
      </list-item>

      <list-item class="setting-item" type="toggle" onclick="toggleAutoCalc">
        <text class="setting-label">化学方程式自动计算</text>
        <image class="toggle-img" src="{{autoCalcOn ? '/Common/toggle_on.png' : '/Common/toggle_off.png'}}"></image>
      </list-item>

      <list-item class="desc-item" type="desc">
        <div class="setting-desc">
          <text class="desc-text">开启后输入化学方程式将自动运算结果，</text>
          <text class="desc-text">关闭后仅进行配平。</text>
        </div>
      </list-item>

      <list-item class="setting-item" type="toggle" onclick="toggleSmoothCurve">
        <text class="setting-label">图像平滑曲线</text>
        <image class="toggle-img" src="{{smoothOn ? '/Common/toggle_on.png' : '/Common/toggle_off.png'}}"></image>
      </list-item>

      <list-item class="desc-item" type="desc">
        <div class="setting-desc">
          <text class="desc-text">开启后函数图像采样点增至150个，</text>
          <text class="desc-text">曲线更平滑；关闭则使用默认采样。</text>
        </div>
      </list-item>

      <list-item class="setting-item" type="toggle" onclick="openReward">
        <text class="setting-label">赞赏我们</text>
      </list-item>

      <list-item class="setting-item" type="toggle" onclick="openAbout">
        <text class="setting-label">关于应用</text>
      </list-item>

      <list-item class="bottom-spacer" type="spacer">
        <text class="spacer-text"></text>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page {
    width: 336px;
    height: 480px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-bar {
    width: 320px;
    height: 48px;
    margin-top: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .header-title {
    color: #ffffff;
    font-size: 28px;
    font-weight: 800;
  }

  .settings-list {
    width: 320px;
    height: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .setting-item {
    width: 320px;
    height: 84px;
    border-radius: 42px;
    background-color: rgba(128, 128, 128, 0.35);
    border-width: 3px;
    border-color: #888888;
    margin-top: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
  }

  .desc-item {
    width: 320px;
    margin-top: 4px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 24px;
  }

  .setting-desc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .setting-label {
    color: #ffffff;
    font-size: 22px;
    font-weight: 800;
  }

  .toggle-img {
    width: 72px;
    height: 36px;
  }

  .desc-text {
    color: #888888;
    font-size: 17px;
    line-height: 22px;
  }

  .bottom-spacer {
    width: 320px;
    height: 30px;
  }

  .spacer-text {
    font-size: 1px;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  var KEY_VIBRATION = 'setting_vibration'
  var KEY_AUTOCALC = 'setting_autocalc'
  var KEY_SMOOTH = 'setting_smooth_curve'

  export default {
    private: {
      vibrationOn: true,
      autoCalcOn: true,
      smoothOn: true
    },

    onBackPress() {
      router.back()
      return true
    },

    onInit() {
      var self = this
      storage.get({
        key: KEY_VIBRATION,
        success: function(data) {
          if (data === 'false') {
            self.vibrationOn = false
          } else {
            self.vibrationOn = true
          }
        },
        fail: function() {
          self.vibrationOn = true
        }
      })
      storage.get({
        key: KEY_AUTOCALC,
        success: function(data) {
          if (data === 'false') {
            self.autoCalcOn = false
          } else {
            self.autoCalcOn = true
          }
        },
        fail: function() {
          self.autoCalcOn = true
        }
      })
      storage.get({
        key: KEY_SMOOTH,
        success: function(data) {
          if (data === 'false') {
            self.smoothOn = false
          } else {
            self.smoothOn = true
          }
        },
        fail: function() {
          self.smoothOn = true
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    toggleVibration() {
      this.vibrationOn = !this.vibrationOn
      this.doVibrate()
      storage.set({
        key: KEY_VIBRATION,
        value: this.vibrationOn ? 'true' : 'false'
      })
    },

    toggleAutoCalc() {
      this.autoCalcOn = !this.autoCalcOn
      this.doVibrate()
      storage.set({
        key: KEY_AUTOCALC,
        value: this.autoCalcOn ? 'true' : 'false'
      })
    },

    toggleSmoothCurve() {
      this.smoothOn = !this.smoothOn
      this.doVibrate()
      storage.set({
        key: KEY_SMOOTH,
        value: this.smoothOn ? 'true' : 'false'
      })
    },

    openReward() {
      this.doVibrate()
      router.push({ uri: '/pages/Reward' })
    },

    openAbout() {
      this.doVibrate()
      router.push({ uri: '/pages/About' })
    }
  }
</script>
