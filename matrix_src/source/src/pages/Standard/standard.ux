<template>
  <div class="page">
    <div class="display-box">
      <text class="expr-text">{{displayExpression}}</text>
      <text class="result-text">{{result}}</text>
    </div>

    <list class="kb-list">
      <list-item class="kb-section">
        <text class="kb-section-text">数字输入</text>
      </list-item>
      <list-item class="key-row">
        <div class="key key-num" onclick="pressNumber('7')"><text class="num-text">7</text></div>
        <div class="key key-num" onclick="pressNumber('8')"><text class="num-text">8</text></div>
        <div class="key key-num" onclick="pressNumber('9')"><text class="num-text">9</text></div>
        <div class="key key-soft" onclick="deleteLast"><text class="func-text">DEL</text></div>
      </list-item>
      <list-item class="key-row">
        <div class="key key-num" onclick="pressNumber('4')"><text class="num-text">4</text></div>
        <div class="key key-num" onclick="pressNumber('5')"><text class="num-text">5</text></div>
        <div class="key key-num" onclick="pressNumber('6')"><text class="num-text">6</text></div>
        <div class="key key-soft" onclick="clearAll"><text class="func-text">AC</text></div>
      </list-item>
      <list-item class="key-row">
        <div class="key key-num" onclick="pressNumber('1')"><text class="num-text">1</text></div>
        <div class="key key-num" onclick="pressNumber('2')"><text class="num-text">2</text></div>
        <div class="key key-num" onclick="pressNumber('3')"><text class="num-text">3</text></div>
        <div class="key key-num" onclick="pressNumber('0')"><text class="num-text">0</text></div>
      </list-item>

      <list-item class="kb-section">
        <text class="kb-section-text">运算功能</text>
      </list-item>
      <list-item class="key-row">
        <div class="key key-op" onclick="pressOperator('+')"><text class="num-text">+</text></div>
        <div class="key key-op" onclick="pressOperator('-')"><text class="num-text">−</text></div>
        <div class="key key-op" onclick="pressOperator('*')"><text class="num-text">×</text></div>
        <div class="key key-op" onclick="pressOperator('/')"><text class="num-text">÷</text></div>
      </list-item>
      <list-item class="key-row">
        <div class="key key-soft" onclick="pressDot"><text class="num-text">.</text></div>
        <div class="key key-soft" onclick="toggleSign"><text class="num-text">±</text></div>
        <div class="key key-soft" onclick="pressParen('(')"><text class="num-text">(</text></div>
        <div class="key key-soft" onclick="pressParen(')')"><text class="num-text">)</text></div>
      </list-item>
      <list-item class="key-row">
        <div class="key key-soft" onclick="clearAll"><text class="func-text">清空</text></div>
        <div class="key key-soft" onclick="deleteLast"><text class="func-text">删除</text></div>
        <div class="key key-soft" onclick="pressNumber('00')"><text class="num-text">00</text></div>
        <div class="key key-equal" onclick="calculate"><text class="num-dark">=</text></div>
      </list-item>
    </list>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .display-box {
    width: 300px;
    height: 76px;
    border-radius: 18px;
    background-color: #1a1a1a;
    margin-top: 8px;
    padding: 6px 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
  }

  .expr-text {
    width: 272px;
    height: 20px;
    color: #888888;
    font-size: 14px;
    text-align: right;
  }

  .result-text {
    width: 272px;
    height: 44px;
    color: #ffffff;
    font-size: 32px;
    font-weight: 700;
    text-align: right;
  }

  .kb-list {
    width: 100%;
    flex-grow: 1;
    margin-top: 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kb-section {
    width: 320px;
    height: 22px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .kb-section-text {
    color: #888888;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }

  .key-row {
    width: 320px;
    height: 58px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .key {
    width: 74px;
    height: 52px;
    margin-left: 3px;
    margin-right: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-num {
    border-radius: 26px;
    background-color: rgba(128, 128, 128, 0.35);
    border-width: 2px;
    border-color: #888888;
  }

  .key-soft {
    border-radius: 24px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
  }

  .key-op {
    border-radius: 24px;
    background-color: rgba(147, 112, 219, 0.35);
    border-width: 2px;
    border-color: #9370db;
  }

  .key-equal {
    border-radius: 24px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
  }

  .num-text {
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
  }

  .num-dark {
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
  }

  .func-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'

  const HISTORY_KEY = 'calc_history_v2'

  export default {
    private: {
      expression: '',
      result: '0',
      justSolved: false,
      vibrationOn: true
    },

    computed: {
      displayExpression() {
        return this.expression || '0'
      }
    },

    onInit() {
      var self = this
      storage.get({
        key: 'setting_vibration',
        success: function(data) {
          self.vibrationOn = data !== 'false'
        }
      })
    },

    doVibrate() {
      if (this.vibrationOn) {
        vibrator.vibrate({ mode: 'short' })
      }
    },

    onBackPress() {
      router.back()
      return true
    },

    clearAll() {
      this.doVibrate()
      this.expression = ''
      this.result = '0'
      this.justSolved = false
    },

    deleteLast() {
      this.doVibrate()
      if (this.justSolved) {
        this.clearAll()
        return
      }
      if (this.expression.length > 1) {
        this.expression = this.expression.substring(0, this.expression.length - 1)
        this.result = this.expression
      } else {
        this.expression = ''
        this.result = '0'
      }
    },

    pressNumber(num) {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = ''
        this.result = '0'
        this.justSolved = false
      }
      this.expression += num
      this.result = this.expression
    },

    pressDot() {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = '0.'
        this.justSolved = false
      } else {
        var part = this.getLastNumber(this.expression)
        if (part.indexOf('.') === -1) {
          this.expression += part === '' ? '0.' : '.'
        }
      }
      this.result = this.expression
    },

    pressOperator(op) {
      this.doVibrate()
      if (this.justSolved) {
        this.expression = this.result
        this.justSolved = false
      }
      if (this.expression === '') {
        if (op === '-') this.expression = '-'
        this.result = this.expression || '0'
        return
      }
      var last = this.expression.charAt(this.expression.length - 1)
      if (this.isOperator(last)) {
        this.expression = this.expression.substring(0, this.expression.length - 1) + op
      } else {
        this.expression += op
      }
      this.result = this.expression
    },

    pressParen(paren) {
      this.doVibrate()
      if (this.justSolved || this.result === '错误') {
        this.expression = ''
        this.justSolved = false
      }
      this.expression += paren
      this.result = this.expression
    },

    toggleSign() {
      this.doVibrate()
      if (this.expression === '' || this.expression === '0') {
        this.expression = '-'
      } else if (this.expression.charAt(0) === '-') {
        this.expression = this.expression.substring(1)
      } else {
        this.expression = '-' + this.expression
      }
      this.result = this.expression || '0'
      this.justSolved = false
    },

    calculate() {
      this.doVibrate()
      try {
        if (this.expression === '') return
        var original = this.expression
        var expr = this.expression.replace(/×/g, '*').replace(/÷/g, '/').replace(/−/g, '-')
        var fn = new Function('return ' + expr)
        var value = fn()
        if (isNaN(value) || !isFinite(value)) {
          this.result = '错误'
        } else {
          this.result = this.formatResult(value)
          this.addHistory(original, this.result)
        }
        this.expression = ''
        this.justSolved = true
      } catch (e) {
        this.result = '错误'
        this.expression = ''
        this.justSolved = true
      }
    },

    addHistory(expr, result) {
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var list = []
          if (data) {
            try { list = JSON.parse(data) } catch (e) { list = [] }
          }
          list.push({ type: '计算器', expr: expr, result: result })
          if (list.length > 30) list = list.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(list) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: '计算器', expr: expr, result: result }]) })
        }
      })
    },

    formatResult(value) {
      var text = String(parseFloat(value.toFixed(10)))
      if (text.length > 12) text = value.toExponential(5)
      return text
    },

    getLastNumber(expr) {
      var number = ''
      for (var i = expr.length - 1; i >= 0; i--) {
        var ch = expr.charAt(i)
        if ((ch >= '0' && ch <= '9') || ch === '.') number = ch + number
        else break
      }
      return number
    },

    isOperator(ch) {
      return ch === '+' || ch === '-' || ch === '*' || ch === '/'
    }
  }
</script>
