<template>
  <div class="page">
    <!-- 输入模式 -->
    <div class="input-mode" if="{{!showResult}}">
      <div class="header-bar">
        <div class="back-btn" onclick="goBack"><text class="back-text">‹</text></div>
        <text class="header-title">三角几何</text>
      </div>

      <div class="side-row">
        <div class="side-box {{activeSide === 'a' ? 'side-active' : ''}}" onclick="selectSide('a')">
          <text class="side-label">a</text>
          <text class="side-val">{{sideA || '0'}}</text>
        </div>
        <div class="side-box {{activeSide === 'b' ? 'side-active' : ''}}" onclick="selectSide('b')">
          <text class="side-label">b</text>
          <text class="side-val">{{sideB || '0'}}</text>
        </div>
        <div class="side-box {{activeSide === 'c' ? 'side-active' : ''}}" onclick="selectSide('c')">
          <text class="side-label">c</text>
          <text class="side-val">{{sideC || '0'}}</text>
        </div>
      </div>

      <div class="keyboard">
        <div class="key-row">
          <div class="key key-num" onclick="pressNum('7')"><text class="num-text">7</text></div>
          <div class="key key-num" onclick="pressNum('8')"><text class="num-text">8</text></div>
          <div class="key key-num" onclick="pressNum('9')"><text class="num-text">9</text></div>
          <div class="key key-soft" onclick="deleteNum"><text class="func-text">DEL</text></div>
        </div>
        <div class="key-row">
          <div class="key key-num" onclick="pressNum('4')"><text class="num-text">4</text></div>
          <div class="key key-num" onclick="pressNum('5')"><text class="num-text">5</text></div>
          <div class="key key-num" onclick="pressNum('6')"><text class="num-text">6</text></div>
          <div class="key key-soft" onclick="clearSide"><text class="func-text">AC</text></div>
        </div>
        <div class="key-row">
          <div class="key key-num" onclick="pressNum('1')"><text class="num-text">1</text></div>
          <div class="key key-num" onclick="pressNum('2')"><text class="num-text">2</text></div>
          <div class="key key-num" onclick="pressNum('3')"><text class="num-text">3</text></div>
          <div class="key key-equal" onclick="drawTriangle"><text class="num-dark">绘制</text></div>
        </div>
        <div class="key-row">
          <div class="key key-num" onclick="pressNum('.')"><text class="num-text">.</text></div>
          <div class="key key-num" onclick="pressNum('0')"><text class="num-text">0</text></div>
          <div class="key key-solve" onclick="drawTriangle"><text class="solve-text">绘制三角形</text></div>
        </div>
      </div>
    </div>

    <!-- 结果模式 -->
    <div class="result-mode" if="{{showResult}}">
      <div class="result-header">
        <div class="back-btn" onclick="backToInput"><text class="back-text">‹</text></div>
        <text class="header-title">三角形</text>
      </div>

      <div class="tri-wrap">
        <div class="tri-box">
          <div class="tri-dot" for="{{triDots}}" style="left:{{$item.l}}px;top:{{$item.t}}px"></div>
          <text class="vertex-tag" style="left:{{vA.l}}px;top:{{vA.t}}px">A</text>
          <text class="vertex-tag" style="left:{{vB.l}}px;top:{{vB.t}}px">B</text>
          <text class="vertex-tag" style="left:{{vC.l}}px;top:{{vC.t}}px">C</text>
        </div>
      </div>

      <list class="result-list">
        <list-item class="angle-item" type="angle" for="{{angles}}">
          <div class="angle-head">
            <text class="angle-name">{{$item.name}}</text>
            <text class="angle-deg">{{$item.deg}}</text>
          </div>
          <div class="trig-row">
            <text class="angle-trig">sin = {{$item.sin}}</text>
            <text class="angle-trig">cos = {{$item.cos}}</text>
            <text class="angle-trig">tan = {{$item.tan}}</text>
          </div>
        </list-item>
      </list>
    </div>
  </div>
</template>

<style>
  .page {
    width: 100%;
    height: 100%;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .input-mode {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .header-bar {
    width: 320px;
    height: 56px;
    margin-top: 8px;
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .back-btn {
    position: absolute;
    left: 0px;
    top: 2px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: #2a2a2a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-text {
    color: #ffffff;
    font-size: 32px;
    font-weight: 800;
  }

  .header-title {
    color: #ffffff;
    font-size: 30px;
    font-weight: 800;
    text-align: center;
  }

  .side-row {
    width: 320px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
  }

  .side-box {
    width: 100px;
    height: 60px;
    border-radius: 20px;
    background-color: rgba(128, 128, 128, 0.3);
    border-width: 2px;
    border-color: #888888;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .side-active {
    border-color: #6495ed;
    background-color: rgba(100, 149, 237, 0.35);
  }

  .side-label {
    color: #cccccc;
    font-size: 24px;
    font-weight: 800;
    margin-right: 8px;
  }

  .side-val {
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
  }

  .keyboard {
    width: 320px;
    flex-grow: 1;
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .key-row {
    width: 320px;
    height: 58px;
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .key {
    width: 74px;
    height: 52px;
    margin-left: 3px;
    margin-right: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-solve {
    width: 156px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .key-num {
    border-radius: 26px;
    background-color: rgba(128, 128, 128, 0.35);
    border-width: 2px;
    border-color: #888888;
  }

  .key-soft {
    border-radius: 24px;
    background-color: rgba(100, 149, 237, 0.35);
    border-width: 2px;
    border-color: #6495ed;
  }

  .key-equal {
    border-radius: 24px;
    background-color: rgba(147, 112, 219, 0.4);
    border-width: 2px;
    border-color: #9370db;
  }

  .num-text {
    color: #ffffff;
    font-size: 28px;
    font-weight: 800;
  }

  .func-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
  }

  .num-dark {
    color: #1a1a2e;
    font-size: 16px;
    font-weight: 800;
  }

  .solve-text {
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
  }

  .result-mode {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .result-header {
    width: 320px;
    height: 52px;
    margin-top: 6px;
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .result-list {
    width: 320px;
    flex-grow: 1;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tri-wrap {
    width: 320px;
    height: 192px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .tri-box {
    width: 260px;
    height: 180px;
    margin-top: 6px;
    position: relative;
  }

  .tri-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    margin-top: -2.5px;
    border-radius: 2.5px;
    background-color: #6495ed;
  }

  .vertex-tag {
    position: absolute;
    color: #ff6b6b;
    font-size: 18px;
    font-weight: 800;
    margin-left: -6px;
    margin-top: -8px;
  }

  .angle-item {
    width: 320px;
    height: 92px;
    border-radius: 18px;
    background-color: rgba(128, 128, 128, 0.25);
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .angle-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .angle-name {
    color: #6495ed;
    font-size: 24px;
    font-weight: 800;
    margin-right: 12px;
  }

  .angle-deg {
    color: #ffffff;
    font-size: 24px;
    font-weight: 800;
  }

  .trig-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
  }

  .angle-trig {
    color: #cccccc;
    font-size: 17px;
    font-weight: 700;
    margin-left: 8px;
    margin-right: 8px;
  }
</style>

<script>
  import router from '@system.router'
  import vibrator from '@system.vibrator'
  import storage from '@system.storage'

  var HISTORY_KEY = 'calc_history_v2'

  export default {
    private: {
      showResult: false,
      activeSide: 'a',
      sideA: '',
      sideB: '',
      sideC: '',
      triDots: [],
      vA: { l: 0, t: 0 },
      vB: { l: 0, t: 0 },
      vC: { l: 0, t: 0 },
      angles: []
    },

    onBackPress() {
      if (this.showResult) {
        this.backToInput()
        return true
      }
      router.back()
      return true
    },

    goBack() {
      this.doVibrate()
      router.back()
    },

    doVibrate() {
      vibrator.vibrate({ mode: 'short' })
    },

    selectSide(side) {
      this.doVibrate()
      this.activeSide = side
    },

    pressNum(ch) {
      this.doVibrate()
      if (ch === '.') {
        var cur = this.getSideVal()
        if (cur.indexOf('.') >= 0) return
        if (cur === '') ch = '0.'
      }
      if (this.activeSide === 'a') {
        if (this.sideA.length < 6) this.sideA += ch
      } else if (this.activeSide === 'b') {
        if (this.sideB.length < 6) this.sideB += ch
      } else {
        if (this.sideC.length < 6) this.sideC += ch
      }
    },

    getSideVal() {
      if (this.activeSide === 'a') return this.sideA
      if (this.activeSide === 'b') return this.sideB
      return this.sideC
    },

    setSideVal(v) {
      if (this.activeSide === 'a') this.sideA = v
      else if (this.activeSide === 'b') this.sideB = v
      else this.sideC = v
    },

    deleteNum() {
      this.doVibrate()
      var cur = this.getSideVal()
      if (cur.length > 0) {
        this.setSideVal(cur.substring(0, cur.length - 1))
      }
    },

    clearSide() {
      this.doVibrate()
      this.setSideVal('')
    },

    drawTriangle() {
      this.doVibrate()
      var a = parseFloat(this.sideA)
      var b = parseFloat(this.sideB)
      var c = parseFloat(this.sideC)
      if (isNaN(a) || isNaN(b) || isNaN(c) || a <= 0 || b <= 0 || c <= 0) {
        this.showToast('请输入三边长度')
        return
      }
      if (a + b <= c || a + c <= b || b + c <= a) {
        this.showToast('三边不能构成三角形')
        return
      }

      // 余弦定理求三个角（弧度）
      var radA = Math.acos((b * b + c * c - a * a) / (2 * b * c))
      var radB = Math.acos((a * a + c * c - b * b) / (2 * a * c))
      var radC = Math.acos((a * a + b * b - c * c) / (2 * a * b))

      var list = [
        this.buildAngle('∠A', radA),
        this.buildAngle('∠B', radB),
        this.buildAngle('∠C', radC)
      ]
      this.angles = list

      this.buildTriangleDots(a, b, c)
      this.showResult = true
      this.addHistory(a, b, c, list)
    },

    addHistory(a, b, c, list) {
      var expr = 'a=' + a + ' b=' + b + ' c=' + c
      var parts = []
      for (var i = 0; i < list.length; i++) {
        var it = list[i]
        parts.push(it.name + ' ' + it.deg + '(sin=' + it.sin + ' cos=' + it.cos + ' tan=' + it.tan + ')')
      }
      var result = parts.join('; ')
      storage.get({
        key: HISTORY_KEY,
        success: function(data) {
          var arr = []
          if (data) {
            try { arr = JSON.parse(data) } catch (e) { arr = [] }
          }
          arr.push({ type: '三角几何', expr: expr, result: result })
          if (arr.length > 30) arr = arr.slice(1)
          storage.set({ key: HISTORY_KEY, value: JSON.stringify(arr) })
        },
        fail: function() {
          storage.set({ key: HISTORY_KEY, value: JSON.stringify([{ type: '三角几何', expr: expr, result: result }]) })
        }
      })
    },

    buildAngle(name, rad) {
      var deg = rad * 180 / Math.PI
      var s = Math.sin(rad)
      var co = Math.cos(rad)
      var t = Math.tan(rad)
      return {
        name: name,
        deg: this.fmt(deg) + '°',
        sin: this.fmt(s),
        cos: this.fmt(co),
        tan: Math.abs(co) < 1e-9 ? '∞' : this.fmt(t)
      }
    },

    fmt(n) {
      var r = Math.round(n * 10000) / 10000
      return String(r)
    },

    showToast(msg) {
      try {
        var prompt = require('@system.prompt')
        prompt.showToast({ message: msg })
      } catch (e) {}
    },

    // 用点阵绘制三角形（与函数图像一致的定位点方式）
    buildTriangleDots(a, b, c) {
      var boxW = 260
      var boxH = 180
      var pad = 26

      // 顶点：A(0,0), B(c,0), C 由余弦定理坐标确定
      // C 距 A 为 b，距 B 为 a
      var cx = (b * b + c * c - a * a) / (2 * c)
      var cySq = b * b - cx * cx
      var cy = cySq > 0 ? Math.sqrt(cySq) : 0

      var pts = [
        { x: 0, y: 0 },      // A
        { x: c, y: 0 },      // B
        { x: cx, y: cy }     // C
      ]

      var minX = Math.min(pts[0].x, pts[1].x, pts[2].x)
      var maxX = Math.max(pts[0].x, pts[1].x, pts[2].x)
      var minY = Math.min(pts[0].y, pts[1].y, pts[2].y)
      var maxY = Math.max(pts[0].y, pts[1].y, pts[2].y)
      var spanX = (maxX - minX) || 1
      var spanY = (maxY - minY) || 1

      var scale = Math.min((boxW - 2 * pad) / spanX, (boxH - 2 * pad) / spanY)

      var self = this
      var map = function(p) {
        return {
          l: Math.round(pad + (p.x - minX) * scale),
          t: Math.round((boxH - pad) - (p.y - minY) * scale)
        }
      }

      var A = map(pts[0])
      var B = map(pts[1])
      var C = map(pts[2])
      this.vA = { l: A.l - 10, t: A.t + 6 }
      this.vB = { l: B.l + 2, t: B.t + 6 }
      this.vC = { l: C.l - 4, t: C.t - 10 }

      var dots = []
      this.fillEdge(dots, A, B, 34)
      this.fillEdge(dots, B, C, 34)
      this.fillEdge(dots, C, A, 34)
      this.triDots = dots
    },

    fillEdge(dots, p1, p2, n) {
      for (var i = 0; i <= n; i++) {
        var ratio = i / n
        dots.push({
          l: Math.round(p1.l + (p2.l - p1.l) * ratio),
          t: Math.round(p1.t + (p2.t - p1.t) * ratio)
        })
      }
    },

    backToInput() {
      this.doVibrate()
      this.showResult = false
    }
  }
</script>
